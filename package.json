{
  "name": "friends-of-ute-valley-park",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node ./scripts/ensure-pnpm.mjs",
    "dev": "pnpm run trails:update && astro dev",
    "start": "pnpm run dev",
    "build": "pnpm run trails:update && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint --type-aware && node ./scripts/check-design-tokens.mjs",
    "lint:design": "node ./scripts/check-design-tokens.mjs",
    "lint:fix": "oxlint --fix --type-aware",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "trails:update": "node --experimental-strip-types ./scripts/update-trailforks-data.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/pages-plugin-turnstile": "^1.0.2",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@vueuse/core": "^14.4.0",
    "astro": "^7.4.4",
    "dotenv": "^17.4.2",
    "maplibre-gl": "^6.16.0",
    "resend": "^6.37.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@astrojs/vue": "^7.1.2",
    "@iconify/json": "^2.2.552",
    "@oxlint/plugins": "1.80.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sharp": "^0.35.5",
    "unplugin-icons": "^24.0.0",
    "vue": "^3.5.44"
  },
  "packageManager": "pnpm@12.0.0"
}
