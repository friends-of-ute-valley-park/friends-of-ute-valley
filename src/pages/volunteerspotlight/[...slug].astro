---
import { getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import InstagramIcon from "~icons/mdi/instagram";
import WebsiteIcon from "~icons/mdi/computer";

export async function getStaticPaths() {
  const volunteerSpotlights = await getCollection("volunteer-spotlight");
  return volunteerSpotlights.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"volunteer-spotlight">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={`Volunteer Spotlight: ${entry.data.name}`}
  description={entry.data.intro}
>
  <div class="page spotlight-detail">
    <!-- Record Detail Hero -->
    <section class="subpage-hero" aria-labelledby="spotlight-entry-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <a href="/volunteerspotlight/" class="subpage-hero__back">← Volunteer spotlight archive</a>
          <div class="subpage-hero__split subpage-hero__split--masthead">
            <div class="subpage-hero__copy">
              <p class="subpage-hero__record-meta">Volunteer Spotlight</p>
              <h1 id="spotlight-entry-title" class="subpage-hero__title">
                {entry.data.name}
              </h1>
              <p class="subpage-hero__deck">
                {entry.data.intro}
              </p>
            </div>

            {
              (entry.data.instagram || entry.data.website) && (
                <aside class="subpage-hero__aside-box" aria-label="Volunteer links">
                  <h2 class="subpage-hero__aside-title">Connect</h2>
                  <div class="socials">
                    {
                      entry.data.instagram && (
                        <a
                          href={"https://instagram.com/" + entry.data.instagram}
                          target="_blank"
                          rel="noopener noreferrer nofollow"
                          class="social-item"
                        >
                          <InstagramIcon class="icon" aria-hidden="true" />
                          <span>@{entry.data.instagram}</span>
                        </a>
                      )
                    }
                    {
                      entry.data.website && (
                        <a
                          href={entry.data.website}
                          target="_blank"
                          rel="noopener noreferrer nofollow"
                          class="social-item"
                        >
                          <WebsiteIcon class="icon" aria-hidden="true" />
                          <span>Personal website</span>
                        </a>
                      )
                    }
                  </div>
                </aside>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Story & Photos -->
    <section class="article-layout">
      <div class="article-layout__inner">
        <div class="article-layout__grid">
          <div class="article-layout__main">
            <div class="prose-content">
              <Content />
            </div>
          </div>

          <aside class="article-layout__aside photos">
            {
              entry.data.images.map((image, i) => (
                <div class="article-photo-card photo">
                  <div class="photo-box">
                    <Picture
                      src={image.image}
                      formats={["avif"]}
                      fallbackFormat="webp"
                      alt={`${entry.data.name} action photo ${i + 1}`}
                      width={800}
                      height={800}
                      widths={[400, 800, 1200]}
                      sizes="(min-width: 64rem) 40vw, 94vw"
                      class="photo-image"
                    />
                  </div>
                </div>
              ))
            }
          </aside>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .socials {
    display: grid;
    gap: 0.625rem;
  }

  .social-item {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-brand-strong);
    font-size: var(--text-body-small);
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22rem;
  }

  .social-item :global(.icon) {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  .photos {
    display: grid;
    gap: 1.5rem;
  }

  .photo-box {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-surface-muted);
  }

  .photo-box :global(picture),
  .photo-box :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
