---
import Layout from "@layouts/Layout.astro";
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";

const volunteerSpotlights = await getCollection("volunteer-spotlight");
---

<Layout
  title="Volunteer Spotlight"
  description="Meet the volunteers behind Friends of Ute Valley Park and read spotlight stories from community stewards."
>
  <div class="page spotlight-index">
    <!-- Masthead Utility Hero -->
    <section class="subpage-hero" aria-labelledby="spotlight-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <div class="subpage-hero__split subpage-hero__split--masthead">
            <div class="subpage-hero__copy">
              <h1 id="spotlight-hero-title" class="subpage-hero__title">
                Volunteer spotlight.
              </h1>
              <p class="subpage-hero__deck">
                Stories and reflections from the neighbors, crew leaders, and trail stewards who keep Ute Valley Park healthy year after year.
              </p>
            </div>

            <aside class="subpage-hero__aside-box" aria-label="Get involved">
              <h2 class="subpage-hero__aside-title">Join the trail crew</h2>
              <ul class="subpage-hero__aside-list">
                <li>No experience needed</li>
                <li>Tools and gloves provided</li>
                <li>
                  <a href="/volunteer/" class="text-link">See upcoming workdays →</a>
                </li>
              </ul>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Spotlight Grid -->
    <section class="page-section page-section--surface">
      <div class="page-section__inner">
        <div class="spotlight-grid">
          {
            volunteerSpotlights.map((spotlight) => (
              <a
                href={`/volunteerspotlight/${spotlight.id}/`}
                class="spotlight-card editorial-folio media-zoom-parent"
              >
                <div class="media">
                  <Picture
                    class="image media-cover media-zoom"
                    src={spotlight.data.images[0].image}
                    formats={["avif"]}
                    fallbackFormat="webp"
                    alt={spotlight.data.name}
                    width={540}
                    height={540}
                    position="top"
                    widths={[400, 540, 800]}
                    sizes="(min-width: 100rem) 540px, (min-width: 64rem) 33vw, (min-width: 48rem) 50vw, 100vw"
                  />
                </div>

                <div class="body">
                  <h2 class="title card-title">{spotlight.data.name}</h2>
                  <p class="excerpt">{spotlight.data.intro}</p>
                  <span class="read-link">Read spotlight →</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .spotlight-grid {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .spotlight-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .spotlight-card:hover {
    border-color: var(--color-brand-strong);
  }

  .spotlight-card .media {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-strong);
    background: var(--color-surface-muted);
  }

  .spotlight-card .media :global(picture),
  .spotlight-card .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .spotlight-card .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .spotlight-card .title {
    --card-title-size: 1.5rem;
  }

  .spotlight-card:hover .title {
    color: var(--color-brand-strong);
  }

  .spotlight-card .excerpt {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .spotlight-card .read-link {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--color-brand-strong);
    font-size: var(--text-body-small);
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22rem;
  }

  @media (min-width: 48rem) {
    .spotlight-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .spotlight-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
