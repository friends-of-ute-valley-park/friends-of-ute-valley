---
import Layout from "@layouts/Layout.astro";
import { Picture } from "astro:assets";
import heroImage from "../assets/images/ute-valley-park-biker.jpg";
import DogImage from "../assets/images/dog.jpg";

import LeaveNoTrace from "@components/LeaveNoTrace.astro";
import VisitTrailExplorer from "@components/VisitTrailExplorer.vue";
import { getSortedTrailheads } from "@/utils/content";
import { assertTrailSummary } from "@/utils/trailData";
import trailConditions from "@/data/generated/trailforks-summary.json";
import type { VisitTrailhead } from "@/utils/trailMapModel";

assertTrailSummary(trailConditions);

const sortedTrailheads = await getSortedTrailheads();
const mapTrailheads: VisitTrailhead[] = sortedTrailheads.map((trailhead) => ({
  id: String(trailhead.id),
  displayId: trailhead.data.id.toString().padStart(2, "0"),
  name: trailhead.data.name,
  description: trailhead.data.description,
  coordinates: [trailhead.data.longitude, trailhead.data.latitude],
  url: `/trailheads/${trailhead.id}/`,
}));

const featuredTrails = [
  {
    name: "BeaUTEiful Loop",
    desc: "Ridgetop views of Pikes Peak, Black Forest, and Rockrimmon, winding through ponderosa pines and sandstone outcrops.",
  },
  {
    name: "Rattlesnake Ridge",
    desc: "Wide-open views along a narrow, rocky ridge. Steep and technical, best for experienced hikers and mountain bikers.",
  },
  {
    name: "High Arches Loop",
    desc: "A short loop near Vindicator Trailhead that winds through an old ranch valley toward a natural sandstone arch.",
  },
  {
    name: "Black and Blue Loop",
    desc: "Technical terrain featuring rock gardens, steep grades, a bridge, old mine tailings, and a small cave.",
  },
];
---

<Layout
  title="Visit"
  description="Plan your visit to Ute Valley Park with trailhead locations, map access, park hours, and trail information."
>
  <div class="page visit-page">
    <!-- Framed Split Editorial Hero -->
    <section class="subpage-hero" aria-labelledby="visit-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <div class="subpage-hero__split subpage-hero__split--lead-left">
            <div class="subpage-hero__copy">
              <h1 id="visit-hero-title" class="subpage-hero__title">
                Plan your visit to Ute Valley Park.
              </h1>

              <p class="subpage-hero__deck">
                Set between Centennial Boulevard, Vindicator Drive, and I-25 in northwest Colorado Springs, Ute Valley Park spans 550 acres and 37 interconnected trails accessible from five main trailheads.
              </p>

              <div class="subpage-hero__actions">
                <a href="#trail-explorer" class="button button--brand">
                  Explore trailheads and map
                </a>
                <a href="/rules/" class="text-link">
                  Review park rules
                </a>
              </div>

              <dl class="subpage-hero__facts">
                <div class="subpage-hero__fact">
                  <dt>Trail conditions</dt>
                  <dd>{trailConditions.status}</dd>
                </div>
                <div class="subpage-hero__fact">
                  <dt>Elevation range</dt>
                  <dd>6,400–6,800 ft</dd>
                </div>
                <div class="subpage-hero__fact">
                  <dt>Entry fee</dt>
                  <dd>Free daily entry</dd>
                </div>
              </dl>
            </div>

            <figure class="subpage-hero__plate-figure">
              <div class="subpage-hero__plate visit-hero-plate">
                <Picture
                  src={heroImage}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  alt="Mountain bike overlooking sandstone ridges and the Front Range foothills in Ute Valley Park"
                  width={1008}
                  widths={[640, 1008]}
                  sizes="(min-width: 64rem) 42vw, 94vw"
                  priority
                  class="visit-hero-photo"
                />
              </div>
              <figcaption class="subpage-hero__caption">
                Sunset ridge overlooking the Front Range foothills near the western singletrack.
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Trailhead Explorer -->
    <section id="trail-explorer" class="page-section visit-explorer-section">
      <div class="page-section__inner">
        <VisitTrailExplorer
          trailheads={mapTrailheads}
          conditionNote={trailConditions.note}
          client:visible
        />
      </div>
    </section>

    <!-- Featured Routes Ledger -->
    <section class="page-section page-section--surface" aria-labelledby="visit-trails-title">
      <div class="page-section__inner">
        <div class="folio-rule-header">
          <h2 id="visit-trails-title" class="folio-rule-header__title">
            Featured park loops and ridges.
          </h2>
          <p class="folio-rule-header__deck">
            Ute Valley Park offers routes for every outing, from family meadow strolls to technical rocky singletrack.
          </p>
        </div>

        <div class="trail-ledger feature-grid feature-grid--two">
          {
            featuredTrails.map((trail) => (
              <article class="trail-cell">
                <h3>{trail.name}</h3>
                <p>{trail.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Field Charcoal Rules & Dogs Callout -->
    <section class="visit-rules" aria-labelledby="visit-rules-title">
      <div class="inner l-container">
        <div class="layout">
          <div class="copy">
            <span class="amber-bar" aria-hidden="true"></span>
            <h2 id="visit-rules-title">
              Know before you go.
            </h2>
            <p>
              Dogs must remain on a leash on every trail in Ute Valley Park. Stay on marked routes, yield thoughtfully on shared singletrack, and pack out all trash and pet waste.
            </p>
            <div class="links">
              <a href="/rules/" class="button button--quiet rules-btn">
                Read full park rules
              </a>
              <a href="/leavenotrace/dogs/" class="rules-link">
                Dog etiquette guidelines →
              </a>
            </div>
          </div>

          <figure class="media-figure">
            <div class="media">
              <Picture
                src={DogImage}
                formats={["avif"]}
                fallbackFormat="webp"
                alt="Leashed dog resting along a sunny Ute Valley Park trail"
                width={720}
                height={450}
                widths={[480, 720]}
                sizes="(min-width: 64rem) 44vw, 94vw"
                class="dog-photo"
              />
            </div>
            <figcaption class="media-caption">
              Leashed dogs help protect nesting birds, deer, and fellow park visitors.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <LeaveNoTrace />
  </div>
</Layout>

<style>
  .visit-hero-plate {
    aspect-ratio: 4 / 3;
  }

  .visit-hero-plate :global(picture),
  .visit-hero-plate :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visit-explorer-section {
    background: var(--color-page);
  }

  .trail-ledger {
    --feature-grid-border-color: var(--color-border-strong);
    --feature-grid-background: var(--color-border-strong);
  }

  .trail-cell {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    background: var(--color-surface);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .trail-cell h3 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .trail-cell p {
    max-width: 48ch;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-body-large);
    font-weight: 400;
    line-height: 1.6;
  }

  .visit-rules {
    border-top: 1px solid var(--color-border-strong);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    padding-block: clamp(3.5rem, 6vw, 5rem);
    font-family: var(--font-body);
  }

  .visit-rules .layout {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .visit-rules .copy {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .visit-rules .amber-bar {
    width: 3rem;
    height: 3px;
    background: var(--color-accent);
  }

  .visit-rules h2 {
    margin: 0;
    color: var(--color-text-inverse);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3.125rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.025em;
  }

  .visit-rules p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--text-body-large);
    line-height: 1.6;
  }

  .visit-rules .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    padding-top: 0.5rem;
  }

  .visit-rules .rules-btn {
    border-color: var(--color-surface);
    background: var(--color-surface);
    color: var(--color-text-strong);
    box-shadow: var(--shadow-accent-sm);
  }

  .visit-rules .rules-btn:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-text);
  }

  .visit-rules .rules-link {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    color: var(--color-text-inverse);
    font-size: var(--text-body-small);
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25rem;
  }

  .visit-rules .rules-link:hover {
    color: var(--color-accent);
  }

  .visit-rules .media-figure {
    margin: 0;
  }

  .visit-rules .media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--color-text-inverse) 28%, transparent);
    box-shadow: var(--shadow-accent-sm);
  }

  .visit-rules .media :global(picture),
  .visit-rules .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visit-rules .media-caption {
    margin: 0.75rem 0 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--text-body-small);
  }

  @media (min-width: 64rem) {
    .visit-rules .layout {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    }
  }
</style>
