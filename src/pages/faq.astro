---
import Layout from "@layouts/Layout.astro";
import LeaveNoTraceSmall from "@components/LeaveNoTraceSmall.astro";
import { parkHoursFaqAnswer } from "@/utils/date";

const faqs = [
  {
    topic: "Getting around",
    question: "How do I find my way around Ute Valley Park?",
    answer:
      'Download or photograph the <a class="text-link" href="/visit/">trail map</a> before heading out, and always note which of the five parking trailheads you started from.',
  },
  {
    topic: "Hours",
    question: "What are the official park hours?",
    answer: parkHoursFaqAnswer,
  },
  {
    topic: "Parking",
    question: "Where can I park my car?",
    answer:
      'Find trailhead parking lots, amenities, and Google Maps directions on the <a class="text-link" href="/visit/">Visit page</a>.',
  },
  {
    topic: "Restrooms",
    question: "Are restrooms available at the trailheads?",
    answer:
      "Portable restrooms are available at the Vindicator and South Rockrimmon trailhead parking lots.",
  },
  {
    topic: "Wildlife",
    question: "What wildlife live in Ute Valley Park?",
    answer:
      "Mule deer, bobcats, black bears, mountain lions, and prairie rattlesnakes live throughout this urban wildland. Respect wildlife by giving generous space, keeping dogs leashed, and staying on designated trails.",
  },
  {
    topic: "Safety",
    question: "What should I do if I see a rattlesnake?",
    answer:
      "Stop calmly, give the snake wide space to move away, and avoid disturbing it. Keeping dogs leashed and staying on cleared trail tread minimizes close encounters.",
  },
  {
    topic: "Volunteering",
    question: "How can I volunteer with Friends of Ute Valley Park?",
    answer:
      'Browse upcoming trail workdays and seasonal schedules on the <a class="text-link" href="/volunteer/">Volunteer page</a>.',
  },
];
---

<Layout
  title="FAQ"
  description="Read frequently asked questions about Ute Valley Park including hours, parking, wildlife safety, and volunteer opportunities."
>
  <div class="page faq-page">
    <!-- Masthead Utility Hero -->
    <section class="subpage-hero" aria-labelledby="faq-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <div class="subpage-hero__split subpage-hero__split--masthead">
            <div class="subpage-hero__copy">
              <h1 id="faq-hero-title" class="subpage-hero__title">
                Frequently asked questions.
              </h1>
              <p class="subpage-hero__deck">
                Practical answers about trailheads, park hours, wildlife safety, and getting involved as a volunteer.
              </p>
            </div>

            <aside class="subpage-hero__aside-box" aria-label="Additional help">
              <h2 class="subpage-hero__aside-title">Need another answer?</h2>
              <ul class="subpage-hero__aside-list">
                <li>
                  <a href="/visit/" class="text-link">Interactive trail map</a>
                </li>
                <li>
                  <a href="/rules/" class="text-link">Park rules and ordinances</a>
                </li>
                <li>
                  <a href="/contact/" class="text-link">Contact our volunteer team</a>
                </li>
              </ul>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial Disclosure Ledger -->
    <section class="page-section page-section--surface" aria-labelledby="faq-list-title">
      <div class="page-section__inner page-section__inner--narrow">
        <div class="folio-rule-header">
          <h2 id="faq-list-title" class="folio-rule-header__title">
            Visitor answers.
          </h2>
        </div>

        <div class="faq-list editorial-folio">
          {
            faqs.map((faq, index) => (
              <details class="faq-item" open={index < 2}>
                <summary class="faq-summary">
                  <span class="faq-meta">{faq.topic}</span>
                  <span class="faq-question">{faq.question}</span>
                  <span class="faq-toggle" aria-hidden="true">+</span>
                </summary>
                <div class="faq-answer" set:html={faq.answer} />
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <LeaveNoTraceSmall />
  </div>
</Layout>

<style>
  .faq-list {
    display: grid;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border-muted);
    background: var(--color-surface);
  }

  .faq-item:last-child {
    border-bottom: 0;
  }

  .faq-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.375rem 1.25rem;
    align-items: center;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    cursor: pointer;
    list-style: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:hover {
    background: var(--color-page);
  }

  .faq-meta {
    grid-column: 1 / -1;
    color: var(--color-brand-strong);
    font-size: var(--text-body-small);
    font-weight: 700;
  }

  .faq-question {
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .faq-toggle {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    color: var(--color-text-strong);
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .faq-item[open] .faq-toggle {
    background: var(--color-brand-strong);
    border-color: var(--color-brand-strong);
    color: var(--color-text-inverse);
    transform: rotate(45deg);
  }

  .faq-answer {
    max-width: 64ch;
    padding: 0 clamp(1.25rem, 3vw, 1.75rem) clamp(1.375rem, 3vw, 1.875rem);
    color: var(--color-text-muted);
    font-size: var(--text-body-large);
    line-height: 1.6;
  }

  .faq-answer :global(p) {
    margin: 0;
  }
</style>
