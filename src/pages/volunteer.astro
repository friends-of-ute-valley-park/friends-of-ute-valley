---
import { Picture } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import VolunteerItem from "@components/VolunteerItem.astro";
import LeaveNoTraceSmall from "@components/LeaveNoTraceSmall.astro";
import ContactForm from "@components/ContactForm.vue";
import EmailForm from "@components/EmailForm.vue";
import EngagementPanel from "@components/EngagementPanel.astro";
import StaticCalendar from "@components/StaticCalendar.astro";
import SocialLinks from "@components/SocialLinks.astro";

import { getCollection } from "astro:content";
import { getUpcomingVolunteerEvents } from "@/utils/content";
import { toVolunteerEventView } from "@/utils/EventData";
import VolunteerHeroImage from "../assets/images/volunteer-hero.jpg";
import VolunteerOpportunitiesImage from "../assets/images/volunteer-opportunities.jpg";
import VolunteerInfoImage2 from "../assets/images/volunteer-4.jpg";
import { TURNSTILE_SITE_KEY } from "astro:env/client";

const upcomingVolunteerEvents = await getUpcomingVolunteerEvents();
const meetingLocations = await getCollection("trailheads");
const volunteerEventViews = upcomingVolunteerEvents.map((volunteerEvent) =>
  toVolunteerEventView(volunteerEvent, meetingLocations),
);

const expectations = [
  {
    title: "No experience needed",
    desc: "Our crew leaders walk through the project and demonstrate how to use every tool safely before we head up the trail.",
  },
  {
    title: "Tools are provided",
    desc: "We bring the Pulaskis, pick mattocks, loppers, rakes, and project supplies. Just show up ready to pitch in.",
  },
  {
    title: "What to wear and bring",
    desc: "Wear long pants and sturdy closed-toe shoes, and bring water. Work gloves and eye protection are required and we keep extra pairs on hand to borrow.",
  },
];
---

<Layout
  title="Volunteer"
  description="Volunteer with Friends of Ute Valley Park and join trail maintenance and stewardship events in Colorado Springs."
>
  <div class="page volunteer-page">
    <!-- Framed Split Editorial Hero -->
    <section class="subpage-hero" aria-labelledby="volunteer-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <div class="subpage-hero__split subpage-hero__split--lead-left">
            <div class="subpage-hero__copy">
              <h1 id="volunteer-hero-title" class="subpage-hero__title">
                Volunteer in Ute Valley Park.
              </h1>

              <p class="subpage-hero__deck">
                Spend a couple of hours on the trails alongside your neighbors. We bring the tools and trail know-how; you bring sturdy shoes, water, and a willingness to pitch in.
              </p>

              <div class="subpage-hero__actions">
                <a href="#workdays" class="button button--brand">
                  View scheduled workdays
                </a>
                <a href="#newsletter" class="text-link">
                  Join workday email alerts
                </a>
              </div>

              <dl class="subpage-hero__facts">
                <div class="subpage-hero__fact">
                  <dt>Workday season</dt>
                  <dd>May through October</dd>
                </div>
                <div class="subpage-hero__fact">
                  <dt>Next scheduled date</dt>
                  <dd>
                    {
                      volunteerEventViews.length > 0
                        ? volunteerEventViews[0].formattedDate
                        : "Posted in spring"
                    }
                  </dd>
                </div>
              </dl>
            </div>

            <figure class="subpage-hero__plate-figure">
              <div class="subpage-hero__plate volunteer-hero-plate">
                <Picture
                  src={VolunteerHeroImage}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  alt="Ute Valley Park volunteers gathered around tools at a trailhead briefing"
                  width={1100}
                  widths={[640, 1100]}
                  sizes="(min-width: 64rem) 42vw, 94vw"
                  priority
                  class="volunteer-hero-photo"
                />
              </div>
              <figcaption class="subpage-hero__caption">
                Morning safety briefing before heading out for trail repair and restoration.
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Upcoming Workdays Folio -->
    <section id="workdays" class="page-section page-section--surface" aria-labelledby="workdays-heading">
      <div class="page-section__inner">
        <div class="folio-rule-header">
          <h2 id="workdays-heading" class="folio-rule-header__title">
            Upcoming public workdays.
          </h2>
          <p class="folio-rule-header__deck">
            Register ahead when spots are open so crew leaders can plan tools and group sizes.
          </p>
        </div>

        {
          volunteerEventViews.length > 0 ? (
            <div class="volunteer-events editorial-folio">
              {volunteerEventViews.map((volunteerEvent) => (
                <div class="event-row">
                  <VolunteerItem volunteerEvent={volunteerEvent} />
                </div>
              ))}
            </div>
          ) : (
            <div class="empty-schedule editorial-folio">
              <p>
                No public workdays are currently open for sign-up. Check the seasonal calendar below or join the email list to hear as soon as the next trail day opens.
              </p>
            </div>
          )
        }
      </div>
    </section>

    <!-- Volunteer Opportunities Editorial Split -->
    <section class="page-section" aria-labelledby="opportunities-heading">
      <div class="page-section__inner">
        <div class="volunteer-opps-layout">
          <div class="photo-plate">
            <Picture
              src={VolunteerOpportunitiesImage}
              formats={["avif"]}
              fallbackFormat="webp"
              alt="Volunteer holding a bag of collected litter in a Ute Valley Park meadow"
              width={560}
              height={680}
              widths={[400, 560, 800]}
              sizes="(min-width: 64rem) 34vw, 92vw"
              class="opps-photo"
            />
          </div>

          <div class="opps-copy">
            <div class="folio-rule-header opps-header">
              <h2 id="opportunities-heading" class="folio-rule-header__title">
                Twice-monthly stewardship.
              </h2>
            </div>
            <p class="opps-body">
              Caring for 550 acres takes all of us. We host trail workdays on select Wednesday evenings and weekend mornings from spring through fall. Because exact dates shift with weather and city ranger support, sign up for email updates or follow us
              <SocialLinks variant="inline" /> for the latest schedule.
            </p>
            <a href="/volunteerspotlight/" class="text-link">
              Read volunteer spotlights →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Seasonal Calendar -->
    <section class="page-section page-section--surface">
      <StaticCalendar />
    </section>

    <!-- What to Expect -->
    <section class="page-section" aria-labelledby="expect-heading">
      <div class="page-section__inner">
        <div class="volunteer-field">
          <div class="copy">
            <div class="folio-rule-header expect-header">
              <h2 id="expect-heading" class="folio-rule-header__title">
                What to expect on a workday.
              </h2>
              <p class="folio-rule-header__deck">
                Everyone is welcome, and no prior trail-building experience is required. Projects range from shaping drainage and repairing eroded tread to removing invasive weeds and reseeding native plants.
              </p>
            </div>

            <ol class="field-notes">
              {
                expectations.map((item) => (
                  <li class="field-note">
                    <h3>{item.title}</h3>
                    <p>{item.desc}</p>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="photo-frame">
            <Picture
              src={VolunteerInfoImage2}
              formats={["avif"]}
              fallbackFormat="webp"
              alt="Volunteers clearing trail corridors with hand tools in Ute Valley Park"
              class="field-photo"
              width={704}
              widths={[400, 704, 1056]}
              sizes="(min-width: 64rem) 44vw, 94vw"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Field Charcoal Newsletter Engagement Band -->
    <div id="newsletter">
      <EngagementPanel>
        <h2 slot="heading">Stay updated on upcoming workdays.</h2>
        <p slot="description" class="section-heading__copy">
          We add pop-up workdays throughout the season when the park needs extra hands. Sign up for meeting points, new volunteer dates, and park dispatches.
        </p>
        <div slot="main">
          <EmailForm client:idle />
        </div>
      </EngagementPanel>
    </div>

    <!-- Group / Coordination Inquiry -->
    <section class="volunteer-contact">
      <ContactForm
        default-option="Volunteer"
        client:visible
        turnstileSiteKey={TURNSTILE_SITE_KEY}
      >
        <Fragment slot="title">
          <h2 class="title">Coordinate a group workday.</h2>
        </Fragment>
        <Fragment slot="subtitle">
          Questions about corporate teams, school groups, or upcoming trail projects? Send our volunteer coordinator a note.
        </Fragment>
      </ContactForm>
    </section>

    <LeaveNoTraceSmall />
  </div>
</Layout>

<style>
  .volunteer-hero-plate {
    aspect-ratio: 4 / 3;
  }

  .volunteer-hero-plate :global(picture),
  .volunteer-hero-plate :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .volunteer-events {
    display: grid;
  }

  .volunteer-events .event-row {
    border-bottom: 1px solid var(--color-border-muted);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .volunteer-events .event-row:last-child {
    border-bottom: 0;
  }

  .empty-schedule {
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .empty-schedule p {
    max-width: 60ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body-large);
    line-height: 1.6;
  }

  .volunteer-opps-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .photo-plate {
    aspect-ratio: 4 / 5;
    max-width: 28rem;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    box-shadow: var(--shadow-accent-sm);
  }

  .photo-plate :global(picture),
  .photo-plate :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .opps-copy {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .opps-header {
    width: 100%;
    margin-bottom: 0;
  }

  .opps-body {
    max-width: 56ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body-large);
    line-height: 1.65;
  }

  .volunteer-field {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .volunteer-field .copy {
    display: grid;
    gap: 2rem;
  }

  .expect-header {
    margin-bottom: 0;
  }

  .field-notes {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    background: var(--color-border);
    list-style-position: inside;
  }

  .field-note {
    background: var(--color-surface);
    padding: 1.5rem;
  }

  .field-note h3 {
    display: inline;
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .field-note p {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .volunteer-field .photo-frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    box-shadow: var(--shadow-accent-sm);
  }

  .volunteer-field .photo-frame :global(picture),
  .volunteer-field .photo-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .volunteer-opps-layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .volunteer-field {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    }
  }
</style>
