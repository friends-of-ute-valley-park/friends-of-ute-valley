---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { resolveMeetingLocation } from "../../utils/EventData";
import { formatShortMonthDayYear } from "../../utils/date";
import { Picture } from "astro:assets";
import volunteerImage from "../../assets/images/volunteer.jpg";

export async function getStaticPaths() {
  const eventsEntries = await getCollection("events");
  return eventsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const meetingLocations = await getCollection("trailheads");
const locationInformation = resolveMeetingLocation(entry.data, meetingLocations);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <div class="page event-detail">
    <!-- Record Detail Hero -->
    <section class="subpage-hero" aria-labelledby="event-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <a href="/volunteer/" class="subpage-hero__back">← Volunteer schedule</a>
          <div class="subpage-hero__split subpage-hero__split--masthead">
            <div class="subpage-hero__copy">
              <p class="subpage-hero__record-meta">
                {formatShortMonthDayYear(entry.data.date)} · {entry.data.time}
              </p>
              <h1 id="event-hero-title" class="subpage-hero__title">
                {entry.data.title}
              </h1>
              {entry.data.description && <p class="subpage-hero__deck">{entry.data.description}</p>}
              {
                entry.data.link && (
                  <div class="subpage-hero__actions">
                    <a href={entry.data.link} class="button button--brand">
                      Register for this workday
                    </a>
                  </div>
                )
              }
            </div>

            <aside class="subpage-hero__aside-box" aria-label="Meeting logistics">
              <h2 class="subpage-hero__aside-title">Meeting point</h2>
              <ul class="subpage-hero__aside-list">
                <li>
                  <a href={locationInformation.directionsLink} class="text-link">
                    {locationInformation.name} →
                  </a>
                </li>
                {entry.data.meetingLocation.notes && <li>{entry.data.meetingLocation.notes}</li>}
              </ul>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Workday Body & Photo -->
    <section class="page-section page-section--surface">
      <div class="page-section__inner">
        <div class="event-layout">
          <div class="event-main">
            <div class="prose-content">
              <Content />
            </div>

            {
              entry.data.link && (
                <div class="registration editorial-folio">
                  <h2>Registration required</h2>
                  <p>Please sign up ahead of time so crew leaders can bring enough tools and safety gear for everyone.</p>
                  <div class="reg-actions">
                    <a href={entry.data.link} class="button button--brand">
                      Register online
                    </a>
                    <a
                      href="https://coloradosprings.gov/sites/default/files/inline-images/informed_consent_and_release_form-fillable.pdf"
                      class="button button--quiet"
                    >
                      Consent and release form
                    </a>
                  </div>
                </div>
              )
            }
          </div>

          <figure class="event-media">
            <div class="media-plate">
              <Picture
                src={volunteerImage}
                formats={["avif"]}
                fallbackFormat="webp"
                class="image"
                alt="Volunteers repairing a trail corridor in Ute Valley Park"
                width={800}
                widths={[440, 800]}
                sizes="(min-width: 64rem) 42vw, 94vw"
                priority
              />
            </div>
            <figcaption class="subpage-hero__caption">
              Sturdy closed-toe shoes, long pants, water, and work gloves keep trail crews comfortable and safe.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .event-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .event-main {
    display: grid;
    gap: 2.5rem;
  }

  .registration {
    display: grid;
    gap: 0.875rem;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    background: var(--color-page);
    box-shadow: var(--shadow-accent-sm);
  }

  .registration h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .registration p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .reg-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    padding-top: 0.25rem;
  }

  .event-media {
    margin: 0;
  }

  .media-plate {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-accent-sm);
  }

  .media-plate :global(picture),
  .media-plate :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .event-layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>
