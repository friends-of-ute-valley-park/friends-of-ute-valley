---
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="Privacy Policy"
  description="Read the Friends of Ute Valley Park privacy policy and how we collect, use, and protect website and contact data."
>
  <div class="page privacy-page">
    <!-- Masthead Utility Hero -->
    <section class="subpage-hero" aria-labelledby="privacy-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <div class="subpage-hero__split subpage-hero__split--masthead">
            <div class="subpage-hero__copy">
              <h1 id="privacy-hero-title" class="subpage-hero__title">
                Privacy policy.
              </h1>
              <p class="subpage-hero__deck">
                How Friends of Ute Valley Park collects, uses, and protects your information across this site.
              </p>
            </div>

            <aside class="subpage-hero__aside-box" aria-label="Document metadata">
              <h2 class="subpage-hero__aside-title">Last updated</h2>
              <ul class="subpage-hero__aside-list">
                <li>March 31, 2023</li>
                <li>
                  <a href="mailto:contact@fuvp.org" class="text-link">contact@fuvp.org</a>
                </li>
              </ul>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Policy Content -->
    <section class="page-section page-section--surface">
      <div class="page-section__inner page-section__inner--narrow">
        <div class="privacy-sections">
          <section class="privacy-section">
            <div class="section-index">Section 1</div>
            <div class="content">
              <h2>Information collection</h2>
              <div class="privacy-prose">
                <p>
                  Friends of Ute Valley Park ("we", "us", "our") is committed to protecting the privacy of our website visitors. We collect limited personal data strictly for communication and improving our services.
                </p>
                <ul>
                  <li>
                    <strong>Analytics data</strong>
                    <p>
                      We collect anonymized analytics data to optimize site performance. No personally identifiable information (PII) is captured during this process. We do not employ third-party tracking cookies.
                    </p>
                  </li>
                  <li>
                    <strong>Communication forms</strong>
                    <p>
                      Name and email addresses are collected via contact and volunteer forms. This data is utilized exclusively for addressing specific inquiries.
                    </p>
                  </li>
                  <li>
                    <strong>Subscriptions</strong>
                    <p>
                      Newsletter enrollment requires name and email data. Subscribers may opt out at any time via the provided unsubscribe links.
                    </p>
                  </li>
                </ul>
              </div>
            </div>
          </section>

          <section class="privacy-section">
            <div class="section-index">Section 2</div>
            <div class="content">
              <h2>Data disclosure</h2>
              <div class="privacy-prose">
                <p>
                  We maintain a strict zero-distribution policy regarding personal data.
                </p>
                <ul>
                  <li>
                    <strong>We do not sell your data</strong>
                    <p>
                      We will never sell or lease personal information to third-party entities for any reason.
                    </p>
                  </li>
                  <li>
                    <strong>Service facilitation</strong>
                    <p>
                      Third-party providers (such as Cloudflare Turnstile) may process data only to fulfill specific functional requests such as spam prevention and are contractually bound to privacy standards.
                    </p>
                  </li>
                </ul>
              </div>
            </div>
          </section>

          <section class="privacy-section">
            <div class="section-index">Section 3</div>
            <div class="content">
              <h2>Security and integrity</h2>
              <div class="privacy-prose">
                <p>
                  We implement technical measures to protect data from unauthorized access. However, absolute security of internet transmissions cannot be guaranteed. We periodically review our protocols to maintain high-integrity standards.
                </p>
              </div>
            </div>
          </section>
        </div>

        <div class="privacy-update editorial-folio">
          <div>
            <p class="update-label">Policy questions</p>
            <p class="update-copy">Questions regarding this notice may be sent to Friends of Ute Valley Park.</p>
          </div>
          <a href="/contact/" class="button button--brand">
            Contact us
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .privacy-sections {
    display: grid;
    gap: 3rem;
  }

  .privacy-section {
    display: grid;
    gap: 1rem 2.5rem;
    border-bottom: 1px solid var(--color-border-muted);
    padding-bottom: 2.5rem;
  }

  .privacy-section:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .section-index {
    color: var(--color-brand-strong);
    font-size: var(--text-body-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .privacy-section .content {
    display: grid;
    gap: 1rem;
  }

  .privacy-section .content h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
  }

  .privacy-prose {
    max-width: 62ch;
    color: var(--color-text-muted);
    font-size: var(--text-body-large);
    line-height: 1.6;
  }

  .privacy-prose p {
    margin: 0 0 1rem;
  }

  .privacy-prose p:last-child {
    margin-bottom: 0;
  }

  .privacy-prose ul {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .privacy-prose li {
    border-left: 3px solid var(--color-accent);
    background: var(--color-page);
    padding: 0.875rem 1.25rem;
  }

  .privacy-prose li strong {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--color-text-strong);
    font-size: 1rem;
    font-weight: 700;
  }

  .privacy-update {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 3rem;
    padding: 1.5rem 2rem;
    background: var(--color-page);
    box-shadow: var(--shadow-accent-sm);
  }

  .update-label {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .update-copy {
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  @media (min-width: 48rem) {
    .privacy-section {
      grid-template-columns: 9rem minmax(0, 1fr);
    }

    .privacy-update {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
