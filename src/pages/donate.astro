---
import { Picture } from "astro:assets";
import ContactForm from "../components/ContactForm.vue";
import ZeffyDonationEmbed from "../components/ZeffyDonationEmbed.astro";
import Layout from "../layouts/Layout.astro";
import CheckBadgeIcon from "~icons/heroicons/check-badge";
import BankTransferIcon from "~icons/mdi/bank-transfer";
import BriefcaseCheckIcon from "~icons/mdi/briefcase-check";
import MailboxUpIcon from "~icons/mdi/mailbox-up";
import { TURNSTILE_SITE_KEY } from "astro:env/client";

import VolunteerHeroImage from "../assets/images/volunteer-hero.jpg";

const giftUses = [
  "Trail restoration and drainage repair",
  "Habitat protection and native reseeding",
  "Invasive weed removal",
  "Volunteer tools, gloves, and safety gear",
  "Trailhead educational signs and outreach",
  "Twice-monthly community stewardship workdays",
];

const givingOptions = [
  {
    id: "give-by-mail",
    title: "Mail a check",
    icon: MailboxUpIcon,
    detail: "Friends of Ute Valley Park, PO Box 50122, Colorado Springs, CO 80919",
    nextStep: "Make checks payable to Friends of Ute Valley Park. Include your return address, and an email address if you would like a tax receipt.",
  },
  {
    id: "give-by-bank-transfer",
    title: "Bank transfer",
    icon: BankTransferIcon,
    detail: "ACH, wire, or direct deposit arrangements",
    nextStep: "Send us a note below before sending financial details so our treasurer can coordinate securely.",
  },
  {
    id: "give-through-workplace",
    title: "Workplace giving and matching",
    icon: BriefcaseCheckIcon,
    detail: "Employer matching, Benevity, and team sponsorships",
    nextStep: "Let us know what documentation or W-9 details your employer needs and we will help route it.",
  },
];
---

<Layout
  title="Donate"
  description="Support Friends of Ute Valley Park with an online gift, mailed check, direct deposit arrangement, or corporate giving program."
>
  <div class="page donate-page">
    <!-- Framed Split Editorial Hero with Embedded Donation Plate -->
    <section class="subpage-hero" aria-labelledby="donate-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <div class="subpage-hero__split subpage-hero__split--lead-right">
            <div class="subpage-hero__copy">
              <h1 id="donate-hero-title" class="subpage-hero__title">
                Support Ute Valley Park.
              </h1>

              <p class="subpage-hero__deck">
                Every contribution goes directly toward maintaining trails, restoring Front Range habitat, and equipping neighbors with tools and safety gear in the field.
              </p>

              <div class="subpage-hero__actions">
                <a href="#donation-form" class="button button--brand">
                  Donate online
                </a>
                <a href="#gift-impact" class="text-link">
                  Where your gift goes
                </a>
              </div>

              <dl class="subpage-hero__facts">
                <div class="subpage-hero__fact">
                  <dt>Public charity</dt>
                  <dd>501(c)(3) nonprofit</dd>
                </div>
                <div class="subpage-hero__fact">
                  <dt>Charity EIN</dt>
                  <dd>42-2107142</dd>
                </div>
                <div class="subpage-hero__fact">
                  <dt>Staff overhead</dt>
                  <dd>Zero paid staff</dd>
                </div>
              </dl>
            </div>

            <aside id="donation-form" class="donation-card subpage-hero__plate" aria-label="Online donation form">
              <div class="donation-card__header">
                <h2>Secure online gift</h2>
                <p>Processed fee-free for nonprofits through Zeffy. Give once or monthly.</p>
              </div>
              <div class="donation-card__body">
                <ZeffyDonationEmbed height="620px" mobileHeight="700px" />
              </div>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Where Every Dollar Goes -->
    <section id="gift-impact" class="page-section page-section--surface" aria-labelledby="gift-impact-title">
      <div class="page-section__inner">
        <div class="impact-layout">
          <div class="impact-media">
            <Picture
              src={VolunteerHeroImage}
              formats={["avif"]}
              fallbackFormat="webp"
              alt="Volunteers gather at a Ute Valley Park trailhead with tools and gloves"
              class="impact-photo"
              width={800}
              widths={[400, 800, 1200]}
              sizes="(min-width: 64rem) 46vw, 94vw"
            />
          </div>

          <div class="impact-copy">
            <div class="folio-rule-header impact-header">
              <h2 id="gift-impact-title" class="folio-rule-header__title">
                Every dollar stays in the park.
              </h2>
              <p class="folio-rule-header__deck">
                Friends of Ute Valley Park is run completely by volunteers, so your donation buys materials and tools for the trails rather than administrative overhead.
              </p>
            </div>

            <ul class="gift-list" aria-label="What donations support">
              {
                giftUses.map((item) => (
                  <li>
                    <CheckBadgeIcon class="icon" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Field Charcoal Stewardship Callout -->
    <section class="donate-band">
      <div class="l-container donate-band__inner">
        <div class="donate-band__copy">
          <h2>Steward 550 acres year-round.</h2>
          <p>
            Recurring monthly gifts give volunteers steady resources for tools, native grass seed, and restoration supplies across every season.
          </p>
        </div>
        <a href="#donation-form" class="button button--quiet donate-band__cta">
          Start a monthly or one-time gift
        </a>
      </div>
    </section>

    <!-- Other Ways to Give -->
    <section id="other-ways-to-give" class="page-section page-section--surface" aria-labelledby="other-ways-title">
      <div class="page-section__inner">
        <div class="folio-rule-header">
          <h2 id="other-ways-title" class="folio-rule-header__title">
            Other ways to give.
          </h2>
          <p class="folio-rule-header__deck">
            Prefer to give by check, bank transfer, or workplace matching? Please contact us below before sending bank details so our treasurer can coordinate securely.
          </p>
        </div>

        <div class="giving-grid feature-grid feature-grid--three">
          {
            givingOptions.map((option) => {
              const Icon = option.icon;

              return (
                <article id={option.id} class="giving-card">
                  <div class="card-icon">
                    <Icon aria-hidden="true" />
                  </div>
                  <h3>{option.title}</h3>
                  <p class="giving-detail">{option.detail}</p>
                  <p class="giving-next">{option.nextStep}</p>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Giving Arrangement Form -->
    <ContactForm
      client:idle
      turnstileSiteKey={TURNSTILE_SITE_KEY}
      defaultOption="Other"
    >
      <Fragment slot="title">
        <h2 class="title">Set up a giving arrangement.</h2>
      </Fragment>
      <Fragment slot="subtitle">
        Tell us about bank transfers, matching gifts, corporate volunteer days, or IRS documentation your employer needs.
      </Fragment>
    </ContactForm>

    <!-- Bridge to Volunteering -->
    <section class="volunteer-bridge page-section page-section--surface">
      <div class="l-container bridge-inner">
        <p>Want to give your time on the trails instead?</p>
        <a href="/volunteer/" class="button button--outline">
          View volunteer schedule
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .donation-card {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .donation-card__header {
    border-bottom: 1px solid var(--color-border-muted);
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
  }

  .donation-card__header h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .donation-card__header p {
    margin: 0.375rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-body-small);
    line-height: 1.5;
  }

  .impact-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .impact-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface-muted);
    box-shadow: var(--shadow-accent-sm);
  }

  .impact-media :global(picture),
  .impact-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .impact-copy {
    display: grid;
    gap: 1.5rem;
  }

  .impact-header {
    margin-bottom: 0;
  }

  .gift-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gift-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-strong);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .gift-list .icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-brand-strong);
  }

  .donate-band {
    border-block: 1px solid var(--color-border-strong);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    padding-block: clamp(3rem, 5vw, 4rem);
  }

  .donate-band__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
  }

  .donate-band__copy h2 {
    margin: 0;
    color: var(--color-text-inverse);
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.2vw, 2.625rem);
    font-weight: 700;
    line-height: 1.08;
  }

  .donate-band__copy p {
    max-width: 56ch;
    margin: 0.625rem 0 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--text-body-large);
    line-height: 1.6;
  }

  .donate-band__cta {
    flex-shrink: 0;
    border-color: var(--color-surface);
    background: var(--color-surface);
    color: var(--color-text-strong);
    box-shadow: var(--shadow-accent-sm);
  }

  .donate-band__cta:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-text);
  }

  .giving-grid {
    --feature-grid-border-color: var(--color-border-strong);
    --feature-grid-background: var(--color-border-strong);
  }

  .giving-card {
    display: grid;
    align-content: start;
    gap: 0.875rem;
    background: var(--color-surface);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .card-icon {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    background: var(--color-page);
    color: var(--color-brand-strong);
  }

  .card-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .giving-card h3 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .giving-detail {
    margin: 0;
    color: var(--color-text-strong);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .giving-next {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body-small);
    line-height: 1.55;
  }

  .bridge-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .bridge-inner p {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .donate-band__inner {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 64rem) {
    .impact-layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
</style>
