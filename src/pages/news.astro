---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import { Picture } from "astro:assets";
import { formatShortMonthDayYear } from "@/utils/date";
import { getPublishedNewsEntries } from "@/utils/content";

const publishedNewsEntries = await getPublishedNewsEntries();
const leadPost = publishedNewsEntries[0];
const archivePosts = publishedNewsEntries.slice(1);
---

<Layout
  title="News"
  description="Latest Friends of Ute Valley Park news, announcements, and stewardship updates from Ute Valley Park in Colorado Springs."
>
  <div class="page news-page">
    <!-- Masthead Utility Hero -->
    <section class="subpage-hero" aria-labelledby="news-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <div class="subpage-hero__split subpage-hero__split--masthead">
            <div class="subpage-hero__copy">
              <h1 id="news-hero-title" class="subpage-hero__title">
                News and park dispatches.
              </h1>
              <p class="subpage-hero__deck">
                Stewardship updates, project recaps, seasonal notices, and community announcements from Friends of Ute Valley Park.
              </p>
            </div>

            <aside class="subpage-hero__aside-box" aria-label="Archive summary">
              <h2 class="subpage-hero__aside-title">Park archive</h2>
              <ul class="subpage-hero__aside-list">
                <li>{publishedNewsEntries.length} published dispatches</li>
                <li>
                  <a href="/volunteer/#newsletter" class="text-link">Subscribe to updates</a>
                </li>
              </ul>
            </aside>
          </div>
        </div>
      </div>
    </section>

    {
      leadPost && (
        <section class="page-section page-section--surface" aria-labelledby="lead-dispatch-title">
          <div class="page-section__inner">
            <article class="lead-dispatch editorial-folio">
              <a href={`/news/${leadPost.id}/`} class="lead-dispatch__link">
                <div class="lead-dispatch__media">
                  <Picture
                    src={leadPost.data.coverImage}
                    formats={["avif"]}
                    fallbackFormat="webp"
                    width={960}
                    height={600}
                    widths={[540, 960]}
                    sizes="(min-width: 64rem) 52vw, 94vw"
                    priority
                    alt={leadPost.data.title}
                    class="lead-dispatch__photo"
                  />
                </div>
                <div class="lead-dispatch__body">
                  <time class="lead-dispatch__date" datetime={leadPost.data.publishedOn.toISOString()}>
                    {formatShortMonthDayYear(leadPost.data.publishedOn)}
                  </time>
                  <h2 id="lead-dispatch-title">{leadPost.data.title}</h2>
                  <p>{leadPost.data.previewText}</p>
                  <span class="lead-dispatch__cta">Read full dispatch →</span>
                </div>
              </a>
            </article>
          </div>
        </section>
      )
    }

    <!-- Earlier Dispatches Grid -->
    <section class="page-section" aria-labelledby="archive-heading">
      <div class="page-section__inner">
        <div class="folio-rule-header">
          <h2 id="archive-heading" class="folio-rule-header__title">
            All dispatches.
          </h2>
        </div>

        <div class="news-list">
          {
            archivePosts.map((post) => (
              <Card
                title={post.data.title}
                previewText={post.data.previewText}
                image={post.data.coverImage}
                href={post.id}
                publishedOn={post.data.publishedOn}
              />
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .lead-dispatch__link {
    display: grid;
    color: inherit;
    text-decoration: none;
  }

  .lead-dispatch__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-strong);
    background: var(--color-surface-muted);
  }

  .lead-dispatch__media :global(picture),
  .lead-dispatch__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lead-dispatch__body {
    display: grid;
    align-content: center;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .lead-dispatch__date {
    color: var(--color-text-muted);
    font-size: var(--text-body-small);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .lead-dispatch__body h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .lead-dispatch__link:hover h2 {
    color: var(--color-brand-strong);
  }

  .lead-dispatch__body p {
    max-width: 54ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body-large);
    line-height: 1.6;
  }

  .lead-dispatch__cta {
    color: var(--color-brand-strong);
    font-size: var(--text-body-small);
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25rem;
  }

  .news-list {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 48rem) {
    .news-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .lead-dispatch__link {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .lead-dispatch__media {
      border-right: 1px solid var(--color-border-strong);
      border-bottom: 0;
    }

    .news-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
