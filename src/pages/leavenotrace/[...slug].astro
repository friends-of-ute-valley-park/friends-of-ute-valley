---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Picture } from "astro:assets";

export async function getStaticPaths() {
  const leavenotraceEntries = await getCollection("leavenotrace");
  return leavenotraceEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.topText}>
  <div class="page lnt-guide">
    <!-- Record Detail Hero -->
    <section class="subpage-hero" aria-labelledby="lnt-entry-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <a href="/visit/" class="subpage-hero__back">← Plan your visit</a>
          <div class="subpage-hero__copy">
            <p class="subpage-hero__record-meta">Leave No Trace Field Guide</p>
            <h1 id="lnt-entry-title" class="subpage-hero__title">
              {entry.data.title}
            </h1>
            <p class="subpage-hero__deck">
              {entry.data.topText}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Article Body & Sticky Plate -->
    <section class="article-layout">
      <div class="article-layout__inner">
        <div class="article-layout__grid">
          <div class="article-layout__main">
            <div class="prose-content">
              <Content />
            </div>
          </div>

          <aside class="article-layout__aside">
            <div class="aside-stack">
              <figure class="article-photo-card photo">
                <div class="photo-box">
                  <Picture
                    class="image"
                    formats={["avif"]}
                    fallbackFormat="webp"
                    width={576}
                    height={432}
                    widths={[400, 576, 880]}
                    sizes="(min-width: 64rem) 440px, (min-width: 36rem) 576px, 94vw"
                    src={entry.data.image}
                    alt={entry.data.imageAlt}
                  />
                </div>
                <figcaption class="article-photo-card__meta">
                  <span>{entry.data.imageAlt}</span>
                </figcaption>
              </figure>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .lnt-guide .aside-stack {
    display: grid;
    gap: 1.5rem;
  }

  .lnt-guide .photo-box {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-muted);
  }

  .lnt-guide .photo-box :global(picture),
  .lnt-guide .photo-box :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .lnt-guide .aside-stack {
      position: sticky;
      top: 5.75rem;
    }
  }
</style>
