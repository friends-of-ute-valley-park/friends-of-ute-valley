---
import { Picture } from "astro:assets";
import Layout from "@layouts/Layout.astro";

import DogImage from "../../assets/images/dog.jpg";
import FreyjaPup from "../../assets/images/dogs/freyja_pup.jpg";
import SweetLife from "../../assets/images/dogs/the.sweet.life.of.five.jpg";
import LoganRescue from "../../assets/images/dogs/logan.and.the.rescue.crew.jpg";
import Marisslh from "../../assets/images/dogs/marisslh.jpg";
import RedRockCanyon from "../../assets/images/other-parks/red-rock-canyon-open-space.jpg";
import PalmerPark from "../../assets/images/other-parks/palmer-park.jpg";
import GardenOfTheGods from "../../assets/images/other-parks/garden-of-the-gods.jpg";
import RampartDogPark from "../../assets/images/other-parks/rampart-dog-park.jpg";

const featuredDogs = [
  { src: FreyjaPup, handle: "freyja_pup" },
  { src: SweetLife, handle: "the.sweet.life.of.five" },
  { src: LoganRescue, handle: "logan.and.the.rescue.crew" },
  { src: Marisslh, handle: "marisslh" },
];

const otherParks = [
  {
    name: "Rampart Dog Park",
    image: RampartDogPark,
    type: "Fenced off-leash",
    distance: "6.6 miles",
    time: "15 minutes",
    mapLink: "https://goo.gl/maps/UEAzoaFGxCTFi7Qo9",
    cityLink: "https://coloradosprings.gov/parks/page/rampart-park",
  },
  {
    name: "Garden of the Gods",
    image: GardenOfTheGods,
    type: "Unfenced area",
    distance: "6.9 miles",
    time: "14 minutes",
    mapLink: "https://goo.gl/maps/Vj2851x6X2JSNeX76",
    cityLink: "https://coloradosprings.gov/parks/page/garden-gods",
  },
  {
    name: "Red Rock Canyon Open Space",
    image: RedRockCanyon,
    type: "Unfenced area",
    distance: "7.5 miles",
    time: "15 minutes",
    mapLink: "https://goo.gl/maps/qAKchVJRqyTYUc8v9",
    cityLink: "https://coloradosprings.gov/parks/page/red-rock-canyon-open-space",
  },
  {
    name: "Palmer Park",
    image: PalmerPark,
    type: "Fenced dog park",
    distance: "9.8 miles",
    time: "20 minutes",
    mapLink: "https://goo.gl/maps/sgxAgR8Mnjr86Qt98",
    cityLink: "https://coloradosprings.gov/parks/page/palmer-park",
  },
];

const reasons = [
  {
    title: "City ordinance",
    text: "Colorado Springs Ordinance 6.7.107 requires dogs to stay on a leash. Violations carry fines ranging from $50 to $150.",
  },
  {
    title: "Courtesy to other visitors",
    text: "Not every hiker, child, or leashed dog is comfortable being approached. Staying leashed keeps singletrack welcoming for everyone.",
  },
  {
    title: "Wildlife protection",
    text: "Ute Valley is home to deer, foxes, and ground-nesting birds. Keeping dogs leashed prevents wildlife from being chased or stressed.",
  },
  {
    title: "Rattlesnake safety",
    text: "Prairie rattlesnakes live in the park during warm months. Keeping dogs close on trail reduces dangerous encounters.",
  },
];

const rules = [
  {
    title: "Leash required everywhere",
    text: "There are no off-leash zones inside Ute Valley Park. Keep dogs on a hand-held leash at all times.",
  },
  {
    title: "Pack out all pet waste",
    text: "Carry waste bags all the way to a trailhead receptacle; never leave bags along the edge of the trail.",
  },
  {
    title: "Keep dogs on designated trails",
    text: "Keeping paws on durable tread protects fragile prairie grasses and shallow ponderosa pine roots.",
  },
  {
    title: "Review full park rules",
    text: "Seasonal park hours and trailhead etiquette apply across all 550 acres.",
  },
];
---

<Layout
  title="Dogs at Ute Valley Park"
  description="Dog rules for Ute Valley Park: leash requirements, safety guidance, and nearby off-leash dog parks in Colorado Springs."
>
  <div class="page dogs-page">
    <!-- Framed Split Editorial Hero -->
    <section class="subpage-hero" aria-labelledby="dogs-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <div class="subpage-hero__split subpage-hero__split--lead-left">
            <div class="subpage-hero__copy">
              <h1 id="dogs-hero-title" class="subpage-hero__title">
                Visiting with dogs.
              </h1>

              <p class="subpage-hero__deck">
                Dogs are always welcome on Ute Valley Park trails. To protect your dog, fellow trail visitors, and local wildlife, keep pets on a leash at all times and pack out all waste.
              </p>

              <div class="subpage-hero__actions">
                <a href="#rules" class="button button--brand">
                  Leash rules
                </a>
                <a href="#off-leash" class="text-link">
                  Nearby off-leash dog parks
                </a>
              </div>
            </div>

            <div class="dogs-mosaic editorial-folio" aria-label="Community dogs visiting Ute Valley Park">
              <div class="dogs-mosaic__grid">
                {
                  featuredDogs.map((dog) => (
                    <figure class="dogs-mosaic__cell">
                      <a
                        href={`https://instagram.com/${dog.handle}`}
                        target="_blank"
                        rel="noopener noreferrer nofollow"
                        class="dogs-mosaic__link"
                      >
                        <div class="dogs-mosaic__frame">
                          <Picture
                            src={dog.src}
                            formats={["avif"]}
                            fallbackFormat="webp"
                            alt={`Dog visiting Ute Valley Park (@${dog.handle})`}
                            width={380}
                            height={380}
                            widths={[200, 380, 640]}
                            sizes="(min-width: 64rem) 20vw, 44vw"
                            class="dog-mosaic-photo"
                          />
                        </div>
                        <figcaption class="dogs-mosaic__caption">
                          @{dog.handle}
                        </figcaption>
                      </a>
                    </figure>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Leash Rules Ledger -->
    <section id="rules" class="page-section page-section--surface" aria-labelledby="dog-rules-heading">
      <div class="page-section__inner">
        <div class="dogs-rules-layout">
          <div class="dogs-rules-aside">
            <div class="folio-rule-header dogs-header">
              <h2 id="dog-rules-heading" class="folio-rule-header__title">
                Leash and trail rules.
              </h2>
            </div>

            <figure class="dog-feature-figure">
              <div class="dog-feature-plate">
                <Picture
                  src={DogImage}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  alt="Dog sitting calmly on a leash in Ute Valley Park"
                  width={560}
                  height={560}
                  widths={[400, 560]}
                  sizes="(min-width: 64rem) 34vw, 92vw"
                  class="dog-feature-img"
                />
              </div>
              <figcaption class="subpage-hero__caption">
                Keeping dogs close on trail protects wildlife and prevents rattlesnake bites.
              </figcaption>
            </figure>
          </div>

          <div class="dogs-rules-body">
            <div>
              <h3 class="ledger-group-title">Why leashes are required</h3>
              <div class="rule-cards feature-grid feature-grid--two">
                {
                  reasons.map((item) => (
                    <article class="rule-card">
                      <h4>{item.title}</h4>
                      <p>{item.text}</p>
                    </article>
                  ))
                }
              </div>
            </div>

            <div>
              <h3 class="ledger-group-title">Checklist for your visit</h3>
              <ul class="rule-checklist">
                {
                  rules.map((item) => (
                    <li>
                      <strong>{item.title}:</strong> {item.text}
                    </li>
                  ))
                }
              </ul>
              <div class="rules-footer-link">
                <a href="/rules/" class="text-link">
                  View complete park rules and hours →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Nearby Off-Leash Parks -->
    <section id="off-leash" class="page-section" aria-labelledby="off-leash-heading">
      <div class="page-section__inner">
        <div class="folio-rule-header folio-rule-header--split">
          <div>
            <h2 id="off-leash-heading" class="folio-rule-header__title">
              Off-leash dog parks nearby.
            </h2>
            <p class="folio-rule-header__deck">
              If your dog wants off-leash room to run, several Colorado Springs parks offer dedicated areas nearby.
            </p>
          </div>
          <a
            href="https://coloradosprings.gov/parks/page/dog-parks?mlid=4736"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link"
          >
            City dog parks directory →
          </a>
        </div>

        <div class="dog-park-grid">
          {
            otherParks.map((park) => (
              <article class="dog-park-card editorial-folio">
                <div class="dog-park-media">
                  <Picture
                    src={park.image}
                    formats={["avif"]}
                    fallbackFormat="webp"
                    alt={park.name}
                    width={420}
                    height={262}
                    widths={[384, 480]}
                    sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 46vw, 94vw"
                    class="dog-park-img"
                  />
                </div>
                <div class="dog-park-body">
                  <p class="dog-park-type">{park.type}</p>
                  <h3>{park.name}</h3>
                  <dl class="dog-park-stats">
                    <div>
                      <dt>Distance</dt>
                      <dd>{park.distance}</dd>
                    </div>
                    <div>
                      <dt>Drive time</dt>
                      <dd>{park.time}</dd>
                    </div>
                  </dl>
                  <div class="dog-park-links">
                    <a href={park.mapLink} target="_blank" rel="noopener noreferrer">
                      Directions →
                    </a>
                    <a href={park.cityLink} target="_blank" rel="noopener noreferrer">
                      Park page →
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .dogs-mosaic {
    padding: 0.75rem;
    box-shadow: var(--shadow-accent-sm);
  }

  .dogs-mosaic__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .dogs-mosaic__cell {
    margin: 0;
  }

  .dogs-mosaic__link {
    display: grid;
    gap: 0.375rem;
    color: var(--color-text-strong);
    text-decoration: none;
  }

  .dogs-mosaic__frame {
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-border-muted);
    background: var(--color-surface-muted);
  }

  .dogs-mosaic__frame :global(picture),
  .dogs-mosaic__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dogs-mosaic__caption {
    color: var(--color-brand-strong);
    font-size: var(--text-body-small);
    font-weight: 600;
  }

  .dogs-mosaic__link:hover .dogs-mosaic__caption {
    text-decoration: underline;
  }

  .dogs-rules-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .dogs-header {
    margin-bottom: 1.5rem;
  }

  .dog-feature-figure {
    margin: 0;
  }

  .dog-feature-plate {
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-accent-sm);
  }

  .dog-feature-plate :global(picture),
  .dog-feature-plate :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dogs-rules-body {
    display: grid;
    gap: 2.5rem;
  }

  .ledger-group-title {
    margin: 0 0 1rem;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .rule-cards {
    --feature-grid-border-color: var(--color-border-strong);
    --feature-grid-background: var(--color-border-strong);
  }

  .rule-card {
    display: grid;
    gap: 0.375rem;
    background: var(--color-page);
    padding: 1.375rem;
  }

  .rule-card h4 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .rule-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .rule-checklist {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .rule-checklist li {
    border-bottom: 1px solid var(--color-border-muted);
    padding-block: 0.875rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .rule-checklist strong {
    color: var(--color-text-strong);
    font-weight: 700;
  }

  .rules-footer-link {
    margin-top: 1.25rem;
  }

  .dog-park-grid {
    display: grid;
    gap: 1.5rem;
  }

  .dog-park-card {
    display: flex;
    flex-direction: column;
  }

  .dog-park-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-strong);
    background: var(--color-surface-muted);
  }

  .dog-park-media :global(picture),
  .dog-park-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dog-park-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .dog-park-type {
    margin: 0;
    color: var(--color-brand-strong);
    font-size: var(--text-body-small);
    font-weight: 700;
  }

  .dog-park-body h3 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .dog-park-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
    margin: 0;
    border-top: 1px solid var(--color-border-muted);
    padding-top: 0.75rem;
  }

  .dog-park-stats dt {
    color: var(--color-text-muted);
    font-size: var(--text-body-small);
  }

  .dog-park-stats dd {
    margin: 0;
    color: var(--color-text-strong);
    font-size: var(--text-body-small);
    font-weight: 700;
  }

  .dog-park-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .dog-park-links a {
    color: var(--color-brand-strong);
    font-size: var(--text-body-small);
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2rem;
  }

  @media (min-width: 40rem) {
    .dog-park-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .dogs-rules-layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }

    .dog-park-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
