---
import Layout from "@layouts/Layout.astro";
import EmailForm from "@components/EmailForm.vue";
import ChevronRightIcon from "~icons/heroicons/chevron-right";
import { Image, Picture } from "astro:assets";

import heroImage from "../assets/images/ute-valley-park-hero-full.jpg";
import stewardToolImage from "../assets/images/volunteer-6.jpg";
import outcropLopperImage from "../assets/images/volunteer-7.jpg";
import volunteerCrewImage from "../assets/images/volunteer-hero.jpg";
import springImage from "../assets/images/ute-valley-park-hero-2.jpg";
import summerImage from "../assets/images/ute-valley-park-biker.jpg";
import fallImage from "../assets/images/ute-valley-park-hero-4.jpg";
import winterImage from "../assets/images/ute-valley-park-hero-3.jpg";
import lntLogo from "../assets/images/logos/leave-no-trace.png";

import { formatShortMonthDayYear, getParkHoursForDate } from "@/utils/date";
import { getPublishedNewsEntries, getSortedTrailheads, getUpcomingVolunteerEvents } from "@/utils/content";
import { toVolunteerEventView } from "@/utils/EventData";
import { assertTrailSummary } from "@/utils/trailData";
import trailConditions from "@/data/generated/trailforks-summary.json";

assertTrailSummary(trailConditions);

const publishedNewsEntries = await getPublishedNewsEntries();
const leadDispatch = publishedNewsEntries[0];
const secondaryDispatches = publishedNewsEntries.slice(1, 4);

const sortedTrailheads = await getSortedTrailheads();
const upcomingVolunteerEvents = await getUpcomingVolunteerEvents();
const nextVolunteerEvent = upcomingVolunteerEvents.length > 0 ? toVolunteerEventView(upcomingVolunteerEvents[0], sortedTrailheads) : null;

const buildDate = new Date();
const trailUpdatedAt = new Date(trailConditions.generatedAt);
const trailsLookIdeal = /ideal/i.test(trailConditions.status);
const { season: parkSeason, hours: parkHours } = getParkHoursForDate(buildDate);

const getSeasonKeyForDate = (date: Date): "spring" | "summer" | "fall" | "winter" => {
  const month = date.getMonth() + 1;
  if (month >= 3 && month <= 5) return "spring";
  if (month >= 6 && month <= 8) return "summer";
  if (month >= 9 && month <= 11) return "fall";
  return "winter";
};

const activeSeasonKey = getSeasonKeyForDate(buildDate);

const seasonalGuide = [
  {
    key: "spring",
    label: "Spring",
    intro: "Thawing snow and early warmth leave trails and emerging wildflowers especially fragile. Small choices on spring walks keep soil in place for the rest of the year.",
    image: springImage,
    imageAlt: "Split-rail fence protecting revegetating meadow beside ponderosa pines in Ute Valley Park",
    caption: "Closed social trails and revegetation zones protect tender spring growth.",
    tips: [
      {
        title: "Avoid muddy trails",
        description: "Spring thaw softens sandy soil quickly. Turn back or choose a drier route whenever mud sticks to your shoes or tires.",
      },
      {
        title: "Dress for shifting weather",
        description: "Front Range spring weather swings from bright sun to snow in an hour. Pack layers, sun protection, and water.",
      },
      {
        title: "Give wildlife space",
        description: "Nesting birds and young wildlife are active across scrub oak and ridges. Keep dogs leashed and stay well back.",
      },
      {
        title: "Pack out everything",
        description: "Melting drifts uncover winter litter and pet waste. Carry out every wrapper, bottle, and bag you bring in.",
      },
    ],
  },
  {
    key: "summer",
    label: "Summer",
    intro: "Long sunlit days bring heavy use and dry heat across exposed sandstone ridges. Planning around early light protects both visitors and arid grassland.",
    image: summerImage,
    imageAlt: "Mountain bike handlebars overlooking sunlit Ute Valley Park ridge and Front Range foothills",
    caption: "Early morning and sunset visits beat midday heat on exposed sandstone ridges.",
    tips: [
      {
        title: "Carry extra water",
        description: "Ute Valley has exposed stretches with little shade. Bring more water than you expect to need, especially for dogs and kids.",
      },
      {
        title: "Go early or late",
        description: "Morning and evening visits are cooler, calmer, and gentler on sandy tread during peak summer weeks.",
      },
      {
        title: "Protect dry vegetation",
        description: "Stay on designated trails and keep clear of dry grass. Off-trail shortcuts heighten erosion and fire risk.",
      },
      {
        title: "Leash and pack out",
        description: "Keep dogs on leash, carry pet waste all the way to a trailhead bin, and yield thoughtfully on busy routes.",
      },
    ],
  },
  {
    key: "fall",
    label: "Fall",
    intro: "Crisp mornings, golden scrub oak, and earlier dusk make autumn a favorite season on the ridges. Brittle plants and dry soil still depend on careful footing.",
    image: fallImage,
    imageAlt: "Trail volunteers walking through golden autumn scrub oak under ponderosa pines",
    caption: "Golden scrub oak lines the corridors volunteers clear each autumn.",
    tips: [
      {
        title: "Plan for earlier dusk",
        description: "Evening shadow drops quickly behind the foothills in autumn. Start early enough to finish before dark or carry a light.",
      },
      {
        title: "Yield on busy trails",
        description: "Cooler afternoons bring walkers, runners, riders, and dogs together. Slow down, call out early, and pass with care.",
      },
      {
        title: "Protect living soil crusts",
        description: "Dry grasses and biological soil crusts become brittle late in the year. Keep boots, paws, and tires on durable tread.",
      },
      {
        title: "Pack out everything",
        description: "Afternoon Front Range gusts carry wrappers and bags into brush quickly. Secure gear and carry out everything you bring.",
      },
    ],
  },
  {
    key: "winter",
    label: "Winter",
    intro: "Cold nights and bright Colorado afternoons create daily freeze-thaw cycles. Shaded north slopes hold ice long after sunny sandstone dries.",
    image: winterImage,
    imageAlt: "Snow-covered meadow and ponderosa pines beneath Pikes Peak and a clear winter sky",
    caption: "Fresh snow blankets the park meadow and ponderosa pine stands.",
    tips: [
      {
        title: "Watch for shaded ice",
        description: "North-facing climbs and pine shadows stay slick for days after snowstorms. Pack traction and give other visitors room.",
      },
      {
        title: "Stay off afternoon mud",
        description: "Midday sun thaws top layers into mud over frozen ground. Step back to drier routes if your tread leaves deep prints.",
      },
      {
        title: "Start with daylight to spare",
        description: "Short winter afternoons leave little margin after four o'clock. Check sunset times and carry a headlamp on late outings.",
      },
      {
        title: "Pack out in the snow",
        description: "Fresh snow hides litter and pet waste only until the next warm spell. Carry every item back to the trailhead.",
      },
    ],
  },
] as const;

const impactMetrics = [
  {
    value: "550",
    label: "Acres of urban wildland in northwest Colorado Springs",
  },
  {
    value: "331",
    label: "Volunteer hours logged on trails and habitat in 2025",
  },
  {
    value: "76",
    label: "Neighbors who pitched in across seven 2025 workdays",
  },
  {
    value: "$110,000",
    label: "Raised by residents in 2012 to expand the park by 205 acres",
  },
];

const leaveNoTracePractices = [
  {
    title: "Plan ahead and prepare",
    description: "Check trail conditions, seasonal hours, and shifting Front Range forecasts before leaving the trailhead.",
    href: "/visit/",
    linkText: "Check trailheads and hours",
  },
  {
    title: "Stay on designated trails",
    description: "Durable tread protects fragile biological soil crusts and shallow ponderosa pine feeder roots during dry seasons.",
    href: "/leavenotrace/travel-on-durable-surfaces/",
    linkText: "Why staying on trail matters",
  },
  {
    title: "Pack out all trash and pet waste",
    description: "Carry out every wrapper, bottle, and pet waste bag, using bear-proof bins where provided at trailheads.",
    href: "/leavenotrace/dogs/",
    linkText: "Dog etiquette guidelines",
  },
  {
    title: "Leave rocks, plants, and wildflowers in place",
    description: "Take photographs of sandstone arches, pasqueflowers, and historic mine remnants while leaving natural features undisturbed.",
    href: "/leavenotrace/leave-what-you-find/",
    linkText: "Leave what you find",
  },
  {
    title: "Keep dogs leashed and give wildlife space",
    description: "Mule deer, raptors, and nesting birds share the park year-round. Keep pets leashed and observe wildlife from a distance.",
    href: "/leavenotrace/respect-wildlife/",
    linkText: "Respecting park wildlife",
  },
  {
    title: "Yield and share multi-use trails",
    description: "Hikers, trail runners, mountain bikers, and families share singletrack corridors. Communicate early and pass thoughtfully.",
    href: "/rules/",
    linkText: "Review trail etiquette",
  },
];
---

<Layout
  title="Home"
  description="Friends of Ute Valley Park helps protect and maintain a 550-acre urban wildland in Colorado Springs through stewardship, education, and community action."
  editorialLanding
>
  <div class="home-editorial">
    <!-- Full-Bleed Opening Hero -->
    <section class="hero" aria-labelledby="hero-heading">
      <Picture
        src={heroImage}
        formats={["avif"]}
        fallbackFormat="webp"
        width={1600}
        widths={[640, 1080, 1440, 1800]}
        sizes="100vw"
        priority
        alt="Ute Valley Park sandstone ledges, ponderosa pines, and Pikes Peak beneath an open Front Range sky"
        class="hero-photo"
      />
      <div class="hero-scrim-top" aria-hidden="true"></div>
      <div class="hero-scrim-bottom" aria-hidden="true"></div>

      <div class="l-container hero-content">
        <div class="hero-statement">
          <h1 id="hero-heading" class="hero-title">Keep Ute Valley Park wild.</h1>
          <p class="hero-lede">
            Neighbors maintaining 550 acres of trails, ponderosa pines, and Front Range habitat in northwest Colorado Springs.
          </p>
          <a href="/visit/" class="hero-cta">
            <span>Plan your visit</span>
            <ChevronRightIcon class="cta-icon" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <!-- Section 1: Today in the Park & Five Trailheads -->
    <section class="band-surface today-section reveal-section" aria-labelledby="today-heading">
      <div class="l-container">
        <div class="today-grid">
          <div class="today-lead">
            <h2 id="today-heading" class="section-title">Today in the park</h2>
            <p class="body-copy">{trailConditions.note}</p>
            <p class="freshness-note">
              Updated <time datetime={trailUpdatedAt.toISOString()}>{formatShortMonthDayYear(trailUpdatedAt)}</time>
            </p>
            <div class="section-action">
              <a href="/visit/" class="editorial-btn editorial-btn--brand">
                <span>Explore trail map and conditions</span>
                <ChevronRightIcon class="cta-icon" aria-hidden="true" />
              </a>
            </div>
          </div>

          <dl class="status-ledger">
            <div class="status-row">
              <dt class="status-term">Trail conditions</dt>
              <dd class="status-detail">
                <span class:list={["status-value", trailsLookIdeal ? "status-value--ideal" : "status-value--caution"]}>
                  {trailConditions.status}
                </span>
                <span class="status-meta">{trailConditions.trailCount} mapped trails across 550 acres</span>
              </dd>
            </div>

            <div class="status-row">
              <dt class="status-term">{parkSeason} park hours</dt>
              <dd class="status-detail">
                <span class="status-value">{parkHours}</span>
                <span class="status-meta">Free public entry every day</span>
              </dd>
            </div>

            <div class="status-row">
              <dt class="status-term">Dogs and park rules</dt>
              <dd class="status-detail">
                <span class="status-value">Leash required at all times</span>
                <a href="/rules/" class="inline-link">Read full park rules</a>
              </dd>
            </div>
          </dl>
        </div>

        <div class="trailhead-strip">
          <h3 class="subhead-sans">Five ways into the park</h3>
          <ul class="trailhead-list" role="list">
            {
              sortedTrailheads.map((trailhead) => (
                <li class="trailhead-item">
                  <a href={`/trailheads/${trailhead.id}/`} class="trailhead-link">
                    <span class="trailhead-name">{trailhead.data.name}</span>
                    <span class="trailhead-detail">
                      {trailhead.data.amenities[0]?.description ?? trailhead.data.description}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Section 2: The Mission Spread -->
    <section class="band-limestone mission-section reveal-section" aria-labelledby="mission-heading">
      <div class="l-container">
        <div class="mission-grid">
          <div class="mission-gallery">
            <figure class="figure-plate figure-plate--tall">
              <div class="photo-frame photo-frame--4-5">
                <Picture
                  src={stewardToolImage}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  width={720}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 64rem) 34vw, 92vw"
                  loading="lazy"
                  alt="Ute Valley Park volunteer walking down a pine-lined trail carrying a pick mattock, hand saw, and level"
                  class="frame-photo"
                />
              </div>
              <figcaption class="photo-caption">
                Volunteers bring trail tools, saws, and drainage levels to twice-monthly workdays.
              </figcaption>
            </figure>

            <figure class="figure-plate figure-plate--wide">
              <div class="photo-frame photo-frame--4-3">
                <Picture
                  src={outcropLopperImage}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  width={640}
                  widths={[420, 640, 880]}
                  sizes="(min-width: 64rem) 26vw, 92vw"
                  loading="lazy"
                  alt="Volunteer holding loppers overhead on a Ute Valley Park sandstone outcrop overlooking the Front Range"
                  class="frame-photo"
                />
              </div>
              <figcaption class="photo-caption">
                Corridor clearing on the western sandstone ridges above Rockrimmon.
              </figcaption>
            </figure>
          </div>

          <div class="mission-copy">
            <h2 id="mission-heading" class="section-title">Neighbors caring for 550 wild acres</h2>
            <p class="body-copy">
              Founded in 2012 when local residents raised $110,000 in three and a half months to help expand Ute Valley Park by 205 acres, Friends of Ute Valley Park is an independent, all-volunteer 501(c)(3) nonprofit working alongside Colorado Springs park rangers.
            </p>
            <p class="body-copy">
              From spring thaw through late fall, hikers, trail runners, mountain bikers, and neighborhood families gather to keep this urban wildland resilient for wildlife and every visitor who steps onto the trail.
            </p>

            <ul class="mission-pillars" role="list">
              <li>
                <h3 class="subhead-serif">Trail maintenance</h3>
                <p class="body-copy">Repairing eroded tread, shaping drainage, and clearing corridors across 37 trails.</p>
              </li>
              <li>
                <h3 class="subhead-serif">Habitat restoration</h3>
                <p class="body-copy">Closing unauthorized social trails, pulling invasive thistle, and protecting biological soil crusts.</p>
              </li>
              <li>
                <h3 class="subhead-serif">Visitor education</h3>
                <p class="body-copy">Sharing Leave No Trace practices so ponderosa roots, wildlife, and multi-use access thrive together.</p>
              </li>
            </ul>

            {
              nextVolunteerEvent && (
                <p class="next-workday-note">
                  Next scheduled workday: {nextVolunteerEvent.formattedDate}, {nextVolunteerEvent.time} at {nextVolunteerEvent.meetingLocation}.
                </p>
              )
            }

            <div class="section-action">
              <a href="/volunteer/" class="editorial-btn editorial-btn--brand">
                <span>Join a trail workday</span>
                <ChevronRightIcon class="cta-icon" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Deep Ponderosa Chromatic Band -->
    <section class="band-ponderosa impact-band reveal-section" aria-labelledby="impact-heading">
      <div class="l-container">
        <div class="impact-top">
          <h2 id="impact-heading" class="section-title section-title--inverse">What local hands built</h2>
          <span class="amber-rule" aria-hidden="true"></span>
        </div>

        <dl class="impact-ledger">
          {
            impactMetrics.map((metric) => (
              <div class="impact-cell">
                <dd class="impact-figure">{metric.value}</dd>
                <dt class="impact-label">{metric.label}</dt>
              </div>
            ))
          }
        </dl>

        <div class="voice-spread">
          <figure class="voice-media">
            <div class="photo-frame photo-frame--16-10 photo-frame--inverse">
              <Picture
                src={volunteerCrewImage}
                formats={["avif"]}
                fallbackFormat="webp"
                width={900}
                widths={[540, 900, 1280]}
                sizes="(min-width: 64rem) 46vw, 92vw"
                loading="lazy"
                alt="Volunteers gathered in a circle at a Ute Valley Park trailhead before starting trail work"
                class="frame-photo"
              />
            </div>
          </figure>

          <figure class="voice-quote">
            <blockquote cite="/volunteerspotlight/vance-hewuse/">
              <p>
                "Trail maintenance assures the greatest number of individuals can enjoy the park whether they are walkers, bikers or runners. You get a real sense of achievement when you look back over a restored trail."
              </p>
            </blockquote>
            <figcaption class="voice-attribution">
              Vance Hewuse, Ute Valley trail runner since 1987 and certified crew leader
            </figcaption>
            <a href="/volunteerspotlight/" class="inline-link inline-link--inverse">
              Read volunteer spotlights
            </a>
          </figure>
        </div>
      </div>
    </section>

    <!-- Section 4: Interactive Seasonal Field Guide -->
    <section class="band-surface seasonal-section reveal-section" aria-labelledby="seasonal-heading">
      <div class="l-container">
        <h2 id="seasonal-heading" class="section-title">Caring for the park in every season</h2>

        <div class="season-tabs" data-season-tabs>
          <div class="season-tablist" role="tablist" {...Object.fromEntries([["focusgroup", "tablist nomemory"]])} aria-label="Seasonal park guidance">
            {
              seasonalGuide.map((season) => {
                const isDefault = season.key === activeSeasonKey;
                return (
                  <button
                    type="button"
                    role="tab"
                    id={`season-tab-${season.key}`}
                    class="season-tab"
                    data-season-tab={season.key}
                    aria-selected={isDefault ? "true" : "false"}
                    tabindex={isDefault ? 0 : -1}
                    {...(isDefault ? Object.fromEntries([["focusgroupstart", ""]]) : {})}
                  >
                    {season.label}
                  </button>
                );
              })
            }
          </div>

          <div class="season-panels">
            {
              seasonalGuide.map((season) => {
                const isDefault = season.key === activeSeasonKey;
                return (
                  <div
                    role="tabpanel"
                    aria-labelledby={`season-tab-${season.key}`}
                    data-season-panel={season.key}
                    class="season-panel"
                    hidden={!isDefault ? "until-found" : undefined}
                  >
                    <div class="season-panel-inner">
                      <div class="season-context">
                        <p class="body-copy">{season.intro}</p>
                        <figure class="season-figure">
                          <div class="photo-frame photo-frame--4-3">
                            <Picture
                              src={season.image}
                              formats={["avif"]}
                              fallbackFormat="webp"
                              width={720}
                              widths={[420, 720, 960]}
                              sizes="(min-width: 64rem) 36vw, 92vw"
                              loading="lazy"
                              fetchpriority={isDefault ? undefined : "low"}
                              alt={season.imageAlt}
                              class="frame-photo"
                            />
                          </div>
                          <figcaption class="photo-caption">{season.caption}</figcaption>
                        </figure>
                      </div>

                      <div class="season-tips">
                        {season.tips.map((tip) => (
                          <div class="season-tip">
                            <h3 class="subhead-serif">{tip.title}</h3>
                            <p class="body-copy">{tip.description}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Section 5: Field Dispatches (Asymmetric Front-Page News) -->
    <section class="band-limestone news-section reveal-section" aria-labelledby="news-heading">
      <div class="l-container">
        <div class="section-header-bar">
          <h2 id="news-heading" class="section-title">Field dispatches</h2>
          <a href="/news/" class="inline-link">All park news</a>
        </div>

        <div class="dispatches-layout">
          {
            leadDispatch && (
              <article class="dispatch-lead">
                <a href={`/news/${leadDispatch.id}/`} class="dispatch-lead-link">
                  <div class="photo-frame photo-frame--16-10 dispatch-lead-media">
                    <Picture
                      src={leadDispatch.data.coverImage}
                      formats={["avif"]}
                      fallbackFormat="webp"
                      width={920}
                      widths={[540, 920]}
                      sizes="(min-width: 64rem) 54vw, 92vw"
                      loading="lazy"
                      alt={leadDispatch.data.title}
                      class="frame-photo dispatch-photo-portrait-safe"
                    />
                  </div>
                  <div class="dispatch-lead-body">
                    <time class="dispatch-date" datetime={leadDispatch.data.publishedOn.toISOString()}>
                      {formatShortMonthDayYear(leadDispatch.data.publishedOn)}
                    </time>
                    <h3 class="dispatch-lead-title">{leadDispatch.data.title}</h3>
                    <p class="body-copy">{leadDispatch.data.previewText}</p>
                  </div>
                </a>
              </article>
            )
          }

          <div class="dispatch-stack">
            {
              secondaryDispatches.map((post) => (
                <article class="dispatch-row">
                  <a href={`/news/${post.id}/`} class="dispatch-row-link">
                    <div class="dispatch-row-copy">
                      <time class="dispatch-date" datetime={post.data.publishedOn.toISOString()}>
                        {formatShortMonthDayYear(post.data.publishedOn)}
                      </time>
                      <h3 class="subhead-serif dispatch-row-title">{post.data.title}</h3>
                      <p class="body-copy dispatch-row-excerpt">{post.data.previewText}</p>
                    </div>
                    <div class="photo-frame photo-frame--4-3 dispatch-row-media">
                      <Picture
                        src={post.data.coverImage}
                        formats={["avif"]}
                        fallbackFormat="webp"
                        width={360}
                        widths={[240, 360]}
                        sizes="(min-width: 64rem) 14vw, 32vw"
                        loading="lazy"
                        alt={post.data.title}
                        class="frame-photo dispatch-photo-portrait-safe"
                      />
                    </div>
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Section 6: Leave No Trace Gold Standard Site (Field Charcoal Band) -->
    <section class="band-charcoal lnt-band reveal-section" aria-labelledby="lnt-heading">
      <div class="l-container">
        <div class="lnt-header">
          <h2 id="lnt-heading" class="section-title section-title--inverse">Leave every trail as you found it</h2>
          <p class="body-copy body-copy--inverse">
            Ute Valley Park is a designated Leave No Trace Gold Standard Site. In a dry Front Range ecosystem with thin topsoil and exposed ponderosa pine roots, these six daily habits keep the park healthy.
          </p>
        </div>

        <ul class="lnt-grid" role="list">
          {
            leaveNoTracePractices.map((practice) => (
              <li class="lnt-item">
                <h3 class="subhead-serif subhead-serif--inverse">{practice.title}</h3>
                <p class="body-copy body-copy--inverse">{practice.description}</p>
                <a href={practice.href} class="inline-link inline-link--inverse">
                  {practice.linkText}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="lnt-footer">
          <a
            href="https://www.lnt.org"
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="lnt-partner-plate"
          >
            <Image
              src={lntLogo}
              format="png"
              width={180}
              densities={[1, 2]}
              loading="lazy"
              alt="Leave No Trace Gold Standard Site"
              class="lnt-logo"
            />
            <span class="lnt-partner-caption">Gold Standard Site partner (opens lnt.org in a new tab)</span>
          </a>

          <a href="/rules/" class="editorial-btn editorial-btn--light">
            <span>Read park rules</span>
            <ChevronRightIcon class="cta-icon" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <!-- Section 7: Support & Newsletter Closing Spread -->
    <section class="band-muted support-closing reveal-section" aria-labelledby="donate-heading">
      <div class="l-container">
        <div class="closing-grid">
          <div class="closing-column">
            <h2 id="donate-heading" class="section-title">Keep stewardship volunteer-led</h2>
            <p class="body-copy">
              Friends of Ute Valley Park is an independent 501(c)(3) charity with zero paid staff. Every gift buys trail tools, work gloves, native seed, restoration materials, and visitor education for the park.
            </p>
            <p class="trust-meta">
              Independent 501(c)(3) public charity · EIN 42-2107142 · 100% focused on Ute Valley Park
            </p>
            <div class="section-action">
              <a href="/donate/" class="editorial-btn editorial-btn--brand">
