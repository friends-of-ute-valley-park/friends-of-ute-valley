<script>
  function initSeasonTabs() {
    const tablist = document.querySelector<HTMLElement>(".almanac-header-bar [role='tablist']");
    const container = document.querySelector<HTMLElement>("[data-season-tabs]");
    if (!tablist || !container || container.dataset.seasonTabsBound === "true") return;
    container.dataset.seasonTabsBound = "true";

    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>("[data-season-tab]"));
    const panels = Array.from(container.querySelectorAll<HTMLElement>("[data-season-panel]"));
    if (tabs.length === 0 || panels.length === 0) return;

    const selectSeason = (seasonKey: string, focusTab: boolean) => {
      for (const tab of tabs) {
        const isSelected = tab.dataset.seasonTab === seasonKey;
        tab.setAttribute("aria-selected", isSelected ? "true" : "false");
        tab.tabIndex = isSelected ? 0 : -1;
        tab.toggleAttribute("focusgroupstart", isSelected);
        if (isSelected && focusTab) {
          tab.focus();
          tab.scrollIntoView({ block: "nearest", inline: "nearest" });
        }
      }

      for (const panel of panels) {
        const isSelected = panel.dataset.seasonPanel === seasonKey;
        if (isSelected) {
          panel.removeAttribute("hidden");
        } else {
          panel.setAttribute("hidden", "until-found");
        }
      }
    };

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const seasonKey = tab.dataset.seasonTab;
        if (seasonKey) selectSeason(seasonKey, false);
      });

      tab.addEventListener("keydown", (event) => {
        const currentIndex = tabs.indexOf(tab);
        if (currentIndex === -1) return;

        let nextIndex: number | null = null;
        if (event.key === "ArrowRight") nextIndex = (currentIndex + 1) % tabs.length;
        else if (event.key === "ArrowLeft") nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;

        if (nextIndex === null) return;
        event.preventDefault();
        const nextSeason = tabs[nextIndex].dataset.seasonTab;
        if (nextSeason) selectSeason(nextSeason, true);
      });
    }

    for (const panel of panels) {
      panel.addEventListener("beforematch", () => {
        const seasonKey = panel.dataset.seasonPanel;
        if (seasonKey) selectSeason(seasonKey, false);
      });
    }
  }

  initSeasonTabs();
  document.addEventListener("astro:page-load", initSeasonTabs);
</script>

