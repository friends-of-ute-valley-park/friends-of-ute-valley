---
import Layout from "@layouts/Layout.astro";
import LeaveNoTrace from "@components/LeaveNoTrace.astro";
import EmailForm from "@components/EmailForm.vue";
import ZeffyDonationEmbed from "@components/ZeffyDonationEmbed.astro";

import ChevronRightIcon from "~icons/heroicons/chevron-right";
import AccountGroupIcon from "~icons/mdi/account-group";
import ClockIcon from "~icons/mdi/clock-outline";
import DogIcon from "~icons/mdi/dog-side";
import EmailNewsletterIcon from "~icons/mdi/email-newsletter";
import HeartIcon from "~icons/mdi/heart";
import HikingIcon from "~icons/mdi/hiking";
import LeafIcon from "~icons/mdi/leaf";
import PineTreeIcon from "~icons/mdi/pine-tree";
import { Picture } from "astro:assets";
import heroImage from "../assets/images/ute-valley-park-hero-full.jpg";
import heroImage2 from "../assets/images/ute-valley-park-hero-2.jpg";
import mountainViewsImage from "../assets/images/volunteer-7.jpg";
import cta from "../assets/images/volunteer-5.jpg";

import { formatShortMonthDayYear, getParkHoursForDate } from "@/utils/date";
import { getPublishedNewsEntries } from "@/utils/content";
import { assertTrailSummary } from "@/utils/trailData";
import trailConditions from "@/data/generated/trailforks-summary.json";
assertTrailSummary(trailConditions);
const publishedNewsEntries = await getPublishedNewsEntries();
const buildDate = new Date();
const trailUpdatedAt = new Date(trailConditions.generatedAt);
const trailsLookIdeal = /ideal/i.test(trailConditions.status);

const { season: parkSeason, hours: parkHours } = getParkHoursForDate(buildDate);

const seasonalEssentialsBySeason = {
  Winter: {
    title: "Winter",
    intro:
      "Cold nights, short days, and freeze-thaw cycles make the park sensitive. Here is how you can help protect it through winter.",
    tips: [
      {
        title: "Watch for Ice",
        description:
          "Shaded trail sections can stay icy long after sunny areas dry out. Slow down and give other visitors room to pass.",
        tag: "TRAIL SAFETY",
      },
      {
        title: "Stay Off Mud",
        description:
          "Freeze-thaw cycles can leave trails soft by afternoon. Turn back or choose a drier route when soil sticks to your shoes or tires.",
        tag: "TRAIL CARE",
      },
      {
        title: "Start Early Enough",
        description:
          "Winter daylight fades quickly. Plan your route around sunset and bring a light if your visit may run late.",
        tag: "VISITOR PREP",
      },
      {
        title: "Pack Out Everything",
        description:
          "Snow can hide litter and pet waste, but it does not make it disappear. Carry out everything you bring in.",
        tag: "PACK IT OUT",
      },
    ],
  },
  Spring: {
    title: "Spring",
    intro:
      "The park is fragile as it emerges from winter. Here is how you can help keep it healthy through the thaw.",
    tips: [
      {
        title: "Avoid Muddy Trails",
        description:
          "Spring thaw and rains soften the ground. Walking muddy trails causes erosion and lasting damage, so turn back or stick to drier routes.",
        tag: "TRAIL CARE",
      },
      {
        title: "Dress for Shifting Weather",
        description:
          "Spring in Colorado swings from sun to snow. Bring layers, sun protection, and extra water on every outing.",
        tag: "VISITOR PREP",
      },
      {
        title: "Give Wildlife Space",
        description:
          "Nesting birds and newborn animals are active this season. Keep dogs leashed and stay well back from wildlife.",
        tag: "WILDLIFE HABITAT",
      },
      {
        title: "Pack Out Everything",
        description:
          "Melting snow exposes trash and pet waste left behind over winter. Carry out everything you bring in.",
        tag: "PACK IT OUT",
      },
    ],
  },
  Summer: {
    title: "Summer",
    intro:
      "Hot, dry days put extra stress on visitors, wildlife, and the landscape. Here is how you can help care for the park this summer.",
    tips: [
      {
        title: "Carry More Water",
        description:
          "Ute Valley has exposed stretches and little shade. Bring more water than you think you need, especially for kids and dogs.",
        tag: "HEAT SAFETY",
      },
      {
        title: "Go Early or Late",
        description:
          "Morning and evening visits are cooler, calmer, and easier on the trail. Avoid the hottest part of the day when you can.",
        tag: "VISITOR PREP",
      },
      {
        title: "Protect Dry Vegetation",
        description:
          "Stay on designated trails and keep clear of dry grasses. Cutting across fragile areas increases erosion and fire risk.",
        tag: "FIRE AWARENESS",
      },
      {
        title: "Leash and Pack Out",
        description:
          "Keep dogs leashed, carry pet waste all the way out, and give wildlife extra space during the busiest season.",
        tag: "LEAVE NO TRACE",
      },
    ],
  },
  Fall: {
    title: "Fall",
    intro:
      "Cooler weather brings busy trails, changing light, and dry vegetation. Here is how you can help keep autumn visits low impact.",
    tips: [
      {
        title: "Plan for Earlier Dusk",
        description:
          "Evening light drops fast in fall. Start with enough time to finish your route before dark or bring a light.",
        tag: "VISITOR PREP",
      },
      {
        title: "Yield on Busy Trails",
        description:
          "Cooler days bring more walkers, runners, riders, and dogs. Slow down, communicate early, and pass with care.",
        tag: "TRAIL COURTESY",
      },
      {
        title: "Respect Dry Conditions",
        description:
          "Grasses and shrubs can be brittle late in the season. Stay on designated trails and avoid disturbing recovering areas.",
        tag: "HABITAT CARE",
      },
      {
        title: "Pack Out Everything",
        description:
          "Wind can scatter wrappers, bottles, and pet waste bags quickly. Carry out everything you bring in.",
        tag: "PACK IT OUT",
      },
    ],
  },
} as const;

const getSeasonalEssentialsForDate = (date: Date) => {
  const month = date.getMonth() + 1;

  if (month >= 3 && month <= 5) return seasonalEssentialsBySeason.Spring;
  if (month >= 6 && month <= 8) return seasonalEssentialsBySeason.Summer;
  if (month >= 9 && month <= 11) return seasonalEssentialsBySeason.Fall;

  return seasonalEssentialsBySeason.Winter;
};

const seasonalEssentials = getSeasonalEssentialsForDate(buildDate);
---

<Layout
  title="Home"
  description="Friends of Ute Valley Park helps protect and maintain a 550-acre urban wildland in Colorado Springs through stewardship, education, and community action."
>
  <div class="home-page">
    <!-- Hero Section: Park Update -->
    <section class="home-hero">
      <Picture
        src={heroImage}
        formats={["avif", "webp"]}
        width="1800"
        height="1355"
        loading="eager"
        fetchpriority="high"
        alt="Ute Valley Park sandstone, pines, and Pikes Peak under an open sky"
        class="image"
      />
      <div class="hero-fade-x fade-x"></div>
      <div class="hero-fade-corner fade-corner"></div>

      <div class="l-container container">
        <div class="layout">
          <div class="copy">
            <h1 class="title">
              Ute <br /> Valley <br />
              <span>Park.</span>
            </h1>

            <span class="rule"></span>

            <p class="lede">
              A 550-acre urban wildland in Colorado Springs. We are the
              stewards dedicated to its preservation, maintenance, and community
              education.
            </p>

            <nav class="home-actions" aria-label="Homepage actions">
              <a href="/visit/" class="button button--brand">
                <span class="home-button-content">
                  Plan Visit <ChevronRightIcon class="home-button-icon" />
                </span>
              </a>
              <a href="/volunteer/" class="button home-button-secondary">
                Volunteer
              </a>
              <a href="/donate/" class="home-support-link">
                Support the park
              </a>
            </nav>
          </div>

          <aside class="park-status" aria-labelledby="park-status-title">
            <div class="header">
              <h2 id="park-status-title" class="title">
                Current park status
              </h2>
              <p class="stamp">
                Updated <time datetime={trailUpdatedAt.toISOString()}>{formatShortMonthDayYear(trailUpdatedAt)}</time>
              </p>
            </div>

            <dl class="list">
              <div class="item item--wide">
                <dt class="term">
                  <HikingIcon aria-hidden="true" />
                  <span>Trail conditions</span>
                </dt>
                <dd class="detail">
                  <span class:list={["value", "value--lead", { "value--caution": !trailsLookIdeal }]}>
                    {trailConditions.status}
                  </span>
                  <span class="note">{trailConditions.note}</span>
                  <a href="/visit/" class="park-status-link">
                    View trail map &amp; conditions <ChevronRightIcon aria-hidden="true" />
                  </a>
                </dd>
              </div>

              <div class="item">
                <dt class="term">
                  <ClockIcon aria-hidden="true" />
                  <span>{parkSeason} hours</span>
                </dt>
                <dd class="detail">
                  <span class="value">{parkHours}</span>
                </dd>
              </div>

              <div class="item">
                <dt class="term">
                  <DogIcon aria-hidden="true" />
                  <span>Dog policy</span>
                </dt>
                <dd class="detail">
                  <span class="value">Leash required</span>
                  <a href="/rules/" class="park-status-link">
                    Read park rules <ChevronRightIcon aria-hidden="true" />
                  </a>
                </dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <!-- Visual Interlude: The Landscape -->
    <section class="landscape-strip">
      <div class="item">
        <Picture
          src={heroImage2}
          formats={["avif", "webp"]}
          width="600"
          height="600"
          alt="Closed for revegetation sign asking visitors to stay on designated trails"
          class="image"
        />
        <div class="label">Stay on designated trails</div>
      </div>
      <div class="item tablet">
        <Picture
          src={mountainViewsImage}
          formats={["avif", "webp"]}
          width="600"
          height="600"
          alt="Volunteer holding loppers overhead on a sandstone outcrop with mountains behind"
          class="image"
        />
        <div class="label">Mountain Views</div>
      </div>
      <div class="item desktop">
        <Picture
          src={cta}
          formats={["avif", "webp"]}
          width="600"
          height="600"
          alt="Volunteers carrying tools and a bucket along a park trail"
          class="image"
        />
        <div class="label">Active Stewardship</div>
      </div>
    </section>

    <!-- Seasonal Stewardship: Seasonal Guidance -->
    <section class="l-section band seasonal-section content-defer">
      <div class="l-container">
        <div class="section-heading section-heading--split">
          <h2 class="t-section-title">
            {seasonalEssentials.title} <span>Essentials.</span>
          </h2>
          <p>{seasonalEssentials.intro}</p>
        </div>

        <ul class="seasonal-grid">
          {
            seasonalEssentials.tips.map((tip) => (
              <li class="seasonal-card">
                <span class="tag">{tip.tag}</span>
                <h3>{tip.title}</h3>
                <p>{tip.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Stats Section: Redesigned in place -->
    <section class="l-section band band--inverse impact-section content-defer">
      <div class="l-container">
        <div class="layout">
          <div>
            <h2 class="title">
              Our <br />
              <span>Impact.</span>
            </h2>
            <p class="lede">
              2025 was a year of hands-on stewardship and a growing
              community of people who care about Ute Valley Park.
            </p>
          </div>
          <div class="impact-groups">
            {
              [
                {
                  group: "Park Care in 2025",
                  stats: [
                    { label: "Volunteers", value: "76" },
                    { label: "Volunteer Hours", value: "331" },
                    { label: "Stewardship Days", value: "7" },
                  ],
                },
                {
                  group: "Community Reach",
                  stats: [
                    { label: "Instagram", value: "2,500" },
                    { label: "Facebook", value: "2,100" },
                    { label: "Subscribers", value: "600" },
                  ],
                },
              ].map((section) => (
                <div class="impact-group">
                  <h3 class="heading">{section.group}</h3>
                  <dl class="impact-stats">
                    {section.stats.map((stat) => (
                      <div class="impact-stat">
                        <dt class="label">{stat.label}</dt>
                        <dd class="value">{stat.value}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- News Section: The Bulletin Board -->
    <section class="l-section band news-section content-defer">
      <div class="l-container">
        <div class="heading">
          <div>
            <h2 class="t-section-title">
              Latest <span>News.</span>
            </h2>
            <p>News and updates from Ute Valley Park.</p>
          </div>
          <a href="/news" class="all-link">
            View All News
          </a>
        </div>

        <div class="news-grid">
          {
            publishedNewsEntries
              .slice(0, 3)
              .map((post) => (
                <a href={`/news/${post.id}`} class="news-card">
                  <div class="media">
                    <Picture
                      src={post.data.coverImage}
                      formats={["avif", "webp"]}
                      width="600"
                      height="400"
                      alt={post.data.title}
                      class="image"
                    />
                    <div class="date">
                      {formatShortMonthDayYear(post.data.publishedOn)}
                    </div>
                  </div>
                  <div class="body">
                    <h3>{post.data.title}</h3>
                    <p>{post.data.previewText}</p>
                  </div>
                </a>
              ))
          }
        </div>
      </div>
    </section>

    <!-- Engagement: Community Support -->
    <section class="l-section band band--muted support-section content-defer">
      <div class="container l-container">
        <div class="support-split">
          <div class="grid">
            <div class="col donate">
              <div class="meta brand">
                <span class="mark"><HeartIcon aria-hidden="true" /></span>
                <span class="eyebrow t-label">Donate</span>
              </div>
              <h2 class="headline">Support Ute Valley Park.</h2>
              <p class="copy">
                Give through our online donation form to help fund trail stewardship, education, and volunteer work in the park.
              </p>
              <ul class="benefits">
                <li><PineTreeIcon aria-hidden="true" /><span>Restore Trails</span></li>
                <li><LeafIcon aria-hidden="true" /><span>Protect Wildlife</span></li>
                <li><AccountGroupIcon aria-hidden="true" /><span>Inspire Community</span></li>
              </ul>
              <ZeffyDonationEmbed height="520px" />
            </div>

            <div class="rule" aria-hidden="true"></div>
            <div class="or">Or</div>

            <div class="col newsletter">
              <div class="pinned">
                <div class="meta accent">
                  <span class="mark"><EmailNewsletterIcon aria-hidden="true" /></span>
                  <span class="eyebrow t-label">Email Newsletter</span>
                </div>
                <h2 class="headline">Stay in the Loop.</h2>
                <p class="copy">
                  Get park updates, volunteer opportunities, event announcements, and conservation news delivered straight to your inbox.
                </p>
                <EmailForm client:idle />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="leave-no-trace-band content-defer">
      <LeaveNoTrace />
    </div>
  </div>
</Layout>

<style>
  .home-page {
    background: var(--color-page);
    color: var(--color-text);
  }

  .home-page ::selection {
    background: color-mix(in oklab, var(--color-accent) 30%, transparent);
    color: var(--color-brand-strong);
  }

  .home-hero {
    --hero-media: clamp(15rem, 46svh, 28rem);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-page);
  }

  :global(.home-hero .image) {
    position: absolute;
    inset: 0 0 auto;
    z-index: -20;
    width: 100%;
    height: var(--hero-media);
    object-fit: cover;
    object-position: 56% 55%;
  }

  .home-hero .fade-x {
    position: absolute;
    inset: 0 0 auto;
    z-index: -10;
    height: var(--hero-media);
  }

  .home-hero .fade-corner {
    display: none;
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: -10;
    height: 40%;
  }

  .home-hero .container {
    display: flex;
    align-items: end;
    padding-block: calc(var(--hero-media) - 4.5rem) 3rem;
  }

  .home-hero .layout {
    display: grid;
    width: 100%;
    align-items: end;
    gap: 2.5rem;
  }

  .home-hero .copy {
    max-width: 48rem;
  }

  .home-actions,
  .home-button-content {
    display: flex;
    align-items: center;
  }

  .home-hero .rule {
    display: block;
    height: 2px;
    background: var(--color-accent);
  }

  .home-hero .title {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-display-xl);
    font-weight: 900;
    line-height: 0.78;
    letter-spacing: 0;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .home-hero .title span {
    color: var(--color-brand-strong);
  }

  .home-hero .rule {
    width: 3rem;
    margin-block: 2rem 1.5rem;
  }

  .home-hero .lede {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.625;
  }

  .home-actions {
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .home-button-content {
    position: relative;
    z-index: 1;
    gap: 0.5rem;
  }

  .home-button-icon {
    width: 1rem;
    height: 1rem;
  }

  .home-button-secondary {
    border: 2px solid var(--color-brand-strong);
    background: var(--color-page);
    color: var(--color-brand-strong);
    font-weight: 900;
    transition-duration: var(--duration-fast);
  }

  .home-button-secondary:hover {
    background: var(--color-brand-subtle);
  }

  .home-button-secondary:active {
    transform: scale(0.96);
  }

  .home-support-link {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 0.25rem;
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: var(--text-action);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4rem;
    text-transform: uppercase;
    transition: color var(--duration-fast);
  }

  .home-support-link:hover {
    color: var(--color-brand-strong);
  }

  .park-status {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-raised);
  }

  .park-status .header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 1rem clamp(1rem, 4vw, 1.5rem);
    background: var(--color-brand-strong);
    color: var(--color-text-inverse);
  }

  .park-status .title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    color: var(--color-text-inverse);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 900;
    line-height: var(--leading-tight);
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .park-status .title::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    background: var(--color-accent);
    transform: rotate(45deg);
  }

  .park-status .stamp {
    margin: 0;
    color: var(--color-brand-muted);
    font-family: var(--font-label);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .park-status .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--color-border-muted);
  }

  .park-status .item {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding: 1.25rem clamp(1rem, 4vw, 1.5rem);
    background: var(--color-surface);
  }

  .park-status .item--wide {
    grid-column: 1 / -1;
  }

  .park-status .term {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .park-status .term svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--color-brand);
  }

  .park-status .detail {
    display: grid;
    justify-items: start;
    gap: 0.375rem;
    margin: 0;
  }

  .park-status .value {
    color: var(--color-text-strong);
    font-family: var(--font-label);
    font-size: 1rem;
    font-weight: 800;
    line-height: var(--leading-tight);
    font-variant-numeric: tabular-nums;
  }

  .park-status .value--lead {
    color: var(--color-brand-strong);
    font-size: 1.5rem;
  }

  .park-status .value--caution {
    color: var(--color-accent-strong);
  }

  .park-status .note {
    max-width: 34ch;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .park-status .park-status-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.25rem;
    margin-block: -0.5rem -0.75rem;
    color: var(--color-brand-strong);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3rem;
    transition: color var(--duration-fast);
  }

  .park-status .park-status-link svg {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .park-status .park-status-link:hover {
    color: var(--color-brand);
  }

  .park-status .park-status-link:hover svg {
    transform: translateX(0.1875rem);
  }

  .landscape-strip {
    display: grid;
    grid-template-columns: 1fr;
    border-bottom: 1px solid var(--color-border);
  }

  .landscape-strip .item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-right: 1px solid var(--color-border);
  }

  .landscape-strip .item.tablet,
  .landscape-strip .item.desktop {
    display: none;
  }

  :global(.landscape-strip .image),
  :global(.news-card .image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.news-card .image) {
    transition: transform var(--duration-slower) var(--ease-out);
  }

  .news-card:hover :global(.image) {
    transform: scale(1.05);
  }

  .landscape-strip .label {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    border: 1px solid var(--color-border-muted);
    background: color-mix(in oklab, var(--color-surface) 90%, transparent);
    color: var(--color-brand-strong);
    padding: 0.25rem 0.75rem;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

