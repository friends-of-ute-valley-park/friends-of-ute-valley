---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatShortMonthDayYear } from "../../utils/date";
import { Picture } from "astro:assets";

export async function getStaticPaths() {
  const newsEntries = await getCollection("news");
  return newsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.previewText}>
  <div class="page news-detail">
    <!-- Record Detail Hero -->
    <section class="subpage-hero subpage-hero--surface" aria-labelledby="news-entry-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <a href="/news/" class="subpage-hero__back">← All park news</a>
          <div class="subpage-hero__copy">
            <time class="subpage-hero__record-meta" datetime={entry.data.publishedOn.toISOString()}>
              {formatShortMonthDayYear(entry.data.publishedOn)}
            </time>
            <h1 id="news-entry-title" class="subpage-hero__title">
              {entry.data.title}
            </h1>
            {entry.data.previewText && <p class="subpage-hero__deck">{entry.data.previewText}</p>}
          </div>
        </div>
      </div>
    </section>

    <!-- Dispatch Body & Cover Plate -->
    <section class="article-layout">
      <div class="article-layout__inner">
        <div class="article-layout__grid">
          <div class="article-layout__main">
            <div class="prose-content">
              <Content />
            </div>
          </div>

          <aside class="article-layout__aside">
            <div class="aside-stack">
              <figure class="article-photo-card">
                <div class="photo-box">
                  <Picture
                    formats={["avif"]}
                    fallbackFormat="webp"
                    width={576}
                    height={432}
                    widths={[400, 576, 880]}
                    sizes="(min-width: 64rem) 440px, (min-width: 36rem) 576px, 94vw"
                    class="image"
                    src={entry.data.coverImage}
                    alt={`${entry.data.title} cover image`}
                  />
                </div>
                <figcaption class="article-photo-card__meta">
                  <span>Friends of Ute Valley Park dispatch</span>
                </figcaption>
              </figure>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .news-detail .subpage-hero__title {
    max-width: 24ch;
  }

  .news-detail .photo-box {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-muted);
  }

  .news-detail .photo-box :global(picture),
  .news-detail .photo-box :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .news-detail .aside-stack {
      position: sticky;
      top: 5.75rem;
    }
  }

  .news-detail .prose-content :global(.news-video-link) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
  }

  .news-detail .prose-content :global(.news-video-link a) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .news-detail .prose-content :global(figure),
  .news-detail .prose-content :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
