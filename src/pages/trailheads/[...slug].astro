---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const trailheadEntries = await getCollection("trailheads");
  return trailheadEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"trailheads">;
}

const { entry } = Astro.props;
---

<Layout title={entry.data.name} description={entry.data.description}>
  <div class="page trailhead-detail">
    <!-- Record Detail Hero -->
    <section class="subpage-hero" aria-labelledby="trailhead-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <a href="/visit/" class="subpage-hero__back">← Plan your visit</a>
          <div class="subpage-hero__split subpage-hero__split--masthead">
            <div class="subpage-hero__copy">
              <h1 id="trailhead-hero-title" class="subpage-hero__title">
                {entry.data.name}
              </h1>
              <p class="subpage-hero__deck">
                {entry.data.description}
              </p>
              <div class="subpage-hero__actions">
                <a
                  href={entry.data.directionsLink}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="button button--brand"
                >
                  Get directions →
                </a>
                <a href="/visit/#trail-explorer" class="text-link">
                  View interactive park map
                </a>
              </div>
            </div>

            <aside class="subpage-hero__aside-box" aria-label="Trailhead location details">
              <h2 class="subpage-hero__aside-title">Trailhead location</h2>
              <p class="location-copy">{entry.data.location}</p>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Amenities & Locator Map -->
    <section class="page-section page-section--surface">
      <div class="page-section__inner">
        <div class="trailhead-layout">
          <div class="details">
            <div class="folio-rule-header block-header">
              <h2 class="folio-rule-header__title">Available amenities.</h2>
            </div>

            <div class="amenity-list">
              {
                entry.data.amenities.map((amenity) => (
                  <article class="amenity-card">
                    <h3>{amenity.name}</h3>
                    <p>{amenity.description}</p>
                  </article>
                ))
              }
            </div>
          </div>

          <figure class="map-wrap">
            <div class="trailhead-map-card editorial-folio">
              <Picture
                class="trailhead-map"
                src={entry.data.map}
                formats={["avif"]}
                fallbackFormat="webp"
                alt={`${entry.data.name} trailhead map location`}
                width={640}
                widths={[400, 640, 960, 1280]}
                sizes="(min-width: 64rem) 46vw, 94vw"
              />
            </div>
            <figcaption class="subpage-hero__caption">
              Trailhead position relative to connecting Ute Valley Park routes.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Trailhead Photos -->
    {
      entry.data.photos.length > 0 && (
        <section class="page-section" aria-labelledby="trailhead-photos-title">
          <div class="page-section__inner">
            <div class="folio-rule-header">
              <h2 id="trailhead-photos-title" class="folio-rule-header__title">
                Trailhead photographs.
              </h2>
            </div>

            <div class="trailhead-photo-grid">
              {
                entry.data.photos.map((photo) => (
                  <figure class="trailhead-photo">
                    <div class="media media-frame media-zoom-frame">
                      <Picture
                        class="image media-cover media-zoom"
                        src={photo.photo}
                        formats={["avif"]}
                        fallbackFormat="webp"
                        alt={photo.caption}
                        width={780}
                        height={488}
                        widths={[400, 800, 1200]}
                        sizes="(min-width: 48rem) 46vw, 94vw"
                      />
                    </div>
                    <figcaption>{photo.caption}</figcaption>
                  </figure>
                ))
              }
            </div>
          </div>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .location-copy {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .trailhead-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .block-header {
    margin-bottom: 1.5rem;
  }

  .block-header .folio-rule-header__title {
    font-size: clamp(1.5rem, 2.5vw, 2.125rem);
  }

  .amenity-list {
    display: grid;
    gap: 1px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-border);
  }

  .amenity-card {
    display: grid;
    gap: 0.25rem;
    background: var(--color-page);
    padding: 1.25rem 1.5rem;
  }

  .amenity-card h3 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .amenity-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .map-wrap {
    margin: 0;
  }

  .trailhead-map-card {
    overflow: hidden;
    padding: 0.75rem;
    box-shadow: var(--shadow-accent-sm);
  }

  .trailhead-map-card :global(picture),
  .trailhead-map-card :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .trailhead-photo-grid {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .trailhead-photo {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .trailhead-photo .media {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-border-strong);
  }

  .trailhead-photo .media :global(picture),
  .trailhead-photo .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .trailhead-photo figcaption {
    color: var(--color-text-muted);
    font-size: var(--text-body-small);
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .trailhead-photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .trailhead-layout {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    }
  }
</style>
