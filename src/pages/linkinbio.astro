---
import Layout from "@layouts/Layout.astro";
import VolunteerItem from "@components/VolunteerItem.astro";
import SocialLinks from "@components/SocialLinks.astro";

import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { byPriorityDesc, getUpcomingVolunteerEvents } from "@/utils/content";
import { toVolunteerEventView } from "@/utils/EventData";
import Logo from "@/assets/images/logos/logo-medium.jpg";

const upcomingVolunteerEvents = await getUpcomingVolunteerEvents();
const meetingLocations = await getCollection("trailheads");
const volunteerEventViews = upcomingVolunteerEvents.map((volunteerEvent) =>
  toVolunteerEventView(volunteerEvent, meetingLocations),
);
const links = await getCollection("links");
const wishlist = await getCollection("wishlist", ({ data }) => {
  return data.quantityNeeded > 0;
});
const sortedLinks = [...links].sort(byPriorityDesc);
---

<Layout
  title="Link in Bio"
  description="Quick links from Friends of Ute Valley Park including volunteer events, resources, and current wishlist needs."
>
  <div class="link-page">
    <div class="link-card editorial-folio">
      <!-- Double-Rule Masthead Header -->
      <div class="header">
        <div class="identity">
          <div class="logo-frame">
            <Image src={Logo} alt="Friends of Ute Valley Park seal" width={72} height={72} densities={[1, 2]} />
          </div>
          <div class="title-block">
            <h1>Friends of Ute Valley Park</h1>
            <p>Quick links and upcoming workdays</p>
          </div>
          <div class="social">
            <SocialLinks />
          </div>
        </div>
      </div>

      <!-- Upcoming Workdays -->
      {
        volunteerEventViews.length > 0 && (
          <section class="link-section">
            <div class="folio-rule-header section-head">
              <h2>Volunteer opportunities</h2>
            </div>
            <div class="stack">
              {volunteerEventViews.map((volunteerEvent) => (
                <div class="inset">
                  <VolunteerItem volunteerEvent={volunteerEvent} />
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- Quick Links -->
      <section class="link-section is-muted">
        <div class="folio-rule-header section-head">
          <h2>Useful links</h2>
        </div>
        <div class="quick-links">
          {
            sortedLinks.map((link) => (
              <a
                href={link.data.link}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="quick-link"
              >
                <span>{link.data.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Volunteer Wishlist -->
      <section class="link-section">
        <div class="folio-rule-header section-head">
          <h2>Trail equipment wishlist</h2>
        </div>
        <p class="wishlist-intro">
          The following tools and materials support trail workdays in the park. Please{" "}
          <a href="/contact/" class="text-link">contact us</a> to coordinate drop-off.
        </p>

        <div class="wishlist-grid feature-grid">
          {
            wishlist.map((item) => (
              <article class="wishlist-item">
                <div class="media">
                  <Image
                    src={item.data.image}
                    alt={item.data.imageAlt}
                    width={220}
                    height={220}
                    widths={[220, 440]}
                    sizes="(min-width: 48rem) 220px, 40vw"
                    class="image"
                  />
                </div>
                <div class="wishlist-copy">
                  <p class="quantity">{item.data.quantityNeeded} needed</p>
                  <h3>
                    <a
                      href={item.data.link}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                    >
                      {item.data.title}
                    </a>
                  </h3>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .link-page {
    background: var(--color-page);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }

  .link-card {
    width: min(100% - 2rem, 40rem);
    margin-inline: auto;
    box-shadow: var(--shadow-accent-sm);
  }

  .link-card .header,
  .link-section {
    border-bottom: 1px solid var(--color-border-strong);
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .link-section:last-child {
    border-bottom: 0;
  }

  .link-card .header,
  .link-section.is-muted {
    background: var(--color-page);
  }

  .link-card .identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .link-card .logo-frame {
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    padding: 0.25rem;
  }

  .link-card .logo-frame img {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
  }

  .link-card .title-block {
    display: grid;
    gap: 0.375rem;
  }

  .link-card .title-block h1 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .link-card .title-block p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body-small);
    font-weight: 500;
  }

  .link-card .social {
    display: flex;
    width: 100%;
    justify-content: center;
    border-top: 1px solid var(--color-border-muted);
    padding-top: 1rem;
  }

  .section-head {
    margin-bottom: 1.25rem;
  }

  .section-head h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .link-section .stack {
    display: grid;
    gap: 1.5rem;
  }

  .link-section .inset {
    border: 1px solid var(--color-border);
    background: var(--color-page);
    padding: 1.25rem;
  }

  .quick-links {
    display: grid;
    gap: 0.75rem;
  }

  .quick-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text-strong);
    padding: 1rem 1.25rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .quick-link:hover {
    border-color: var(--color-brand-strong);
    background: var(--color-brand-subtle);
  }

  .quick-link span:last-child {
    color: var(--color-brand-strong);
  }

  .wishlist-intro {
    margin: 0 0 1.25rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .wishlist-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    --feature-grid-border-color: var(--color-border-strong);
    --feature-grid-background: var(--color-border-strong);
  }

  .wishlist-item {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    background: var(--color-surface);
    padding: 1rem;
  }

  .wishlist-item .media {
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-border-muted);
    background: var(--color-surface-muted);
  }

  :global(.wishlist-item .image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wishlist-copy {
    display: grid;
    gap: 0.25rem;
  }

  .wishlist-item .quantity {
    margin: 0;
    color: var(--color-brand-strong);
    font-size: var(--text-body-small);
    font-weight: 700;
  }

  .wishlist-item h3 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .wishlist-item h3 a {
    color: inherit;
    text-decoration: none;
  }

  .wishlist-item h3 a:hover {
    color: var(--color-brand-strong);
    text-decoration: underline;
  }
</style>
