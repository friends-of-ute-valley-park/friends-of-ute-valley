---
import LeaveNoTraceSmall from "@components/LeaveNoTraceSmall.astro";
import TeamList from "@components/TeamList.astro";
import Layout from "@layouts/Layout.astro";
import OldPhotos from "@components/OldPhotos.astro";
import StatsCard from "@components/StatsCard.astro";
import { Image, Picture } from "astro:assets";
import PikesPeakHero from "@/assets/images/ute-valley-park-hero.jpg";
import Logo from "@/assets/images/logos/logo-medium.jpg";
import SurveyPreview from "@/assets/images/colorado-land-survey-preview.jpg";

const stewardshipWork = [
  "Conducts volunteer trail maintenance twice a month during the field season",
  "Leads special restoration, corridor clearing, and cleanup projects",
  "Raises community funds to purchase tools, seed, and park improvements",
  "Provides visitor education on park ecology, geology, and Leave No Trace",
  "Advocates for protecting Ute Valley Park as open space",
];

const awards = [
  {
    year: "2023",
    title: "Drew Town, Colorado Springs Parks, Recreation, and Cultural Services Volunteer of the Year Nomination",
  },
  { year: "2022", title: "TOSC Best Friends Group" },
  { year: "2020", title: "Great Outdoors Colorado (GOCO) Award" },
  { year: "2020", title: "Parks & Recreation Volunteer of the Year" },
  { year: "2019", title: "David J. Collas Community Service Award" },
  { year: "2014", title: "City Council Resolution Thanking FUVP" },
  { year: "2014", title: "Friends Group of the Year" },
  { year: "2013", title: "TOSC Stewardship Award" },
  { year: "Past", title: "Dan Woods SuperGroup MVP Award" },
];
---

<Layout
  title="About"
  description="Learn about Friends of Ute Valley Park, our mission, history, and volunteer-led work to protect and maintain Ute Valley Park in Colorado Springs."
>
  <div class="page about-page">
    <!-- Framed Split Editorial Hero -->
    <section class="subpage-hero" aria-labelledby="about-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <div class="subpage-hero__split subpage-hero__split--lead-left">
            <div class="subpage-hero__copy">
              <h1 id="about-hero-title" class="subpage-hero__title">
                Our story and stewardship mission.
              </h1>

              <p class="subpage-hero__deck">
                Friends of Ute Valley Park (FUVP) is an independent, volunteer-led nonprofit dedicated to maintaining, preserving, and educating visitors about Ute Valley Park alongside Colorado Springs park rangers.
              </p>

              <div class="about-emblem-row">
                <Image
                  src={Logo}
                  alt="Friends of Ute Valley Park seal"
                  width={56}
                  height={56}
                  densities={[1, 2]}
                  class="about-emblem-img"
                />
                <p>
                  All-volunteer 501(c)(3) public charity working for Ute Valley Park since 2012.
                </p>
              </div>

              <dl class="subpage-hero__facts">
                <div class="subpage-hero__fact">
                  <dt>Founded</dt>
                  <dd>2012</dd>
                </div>
                <div class="subpage-hero__fact">
                  <dt>Protected open space</dt>
                  <dd>550 acres</dd>
                </div>
                <div class="subpage-hero__fact">
                  <dt>Paid staff</dt>
                  <dd>None (all volunteer)</dd>
                </div>
              </dl>
            </div>

            <figure class="subpage-hero__plate-figure">
              <div class="subpage-hero__plate about-hero-plate">
                <Picture
                  src={PikesPeakHero}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  alt="Sandstone ledges and ponderosa pines in Ute Valley Park looking toward Pikes Peak"
                  width={1000}
                  widths={[540, 1000]}
                  sizes="(min-width: 64rem) 42vw, 94vw"
                  priority
                  class="about-hero-photo"
                />
              </div>
              <figcaption class="subpage-hero__caption">
                Looking west across Ute Valley sandstone toward Pikes Peak.
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Impact Stats Folio -->
    <section class="page-section page-section--surface">
      <div class="page-section__inner">
        <StatsCard />
      </div>
    </section>

    <!-- Structural Chapters & Sticky TOC -->
    <section class="about-records">
      <div class="page-section__inner">
        <div class="layout">
          <div class="about-toc">
            <div class="sticky">
              <p class="toc-title">On this page</p>
              <nav class="links" data-about-toc aria-label="About sections">
                <a href="#history" class="link">Our history</a>
                <a href="#stewardship" class="link">How we care for the park</a>
                <a href="#awards" class="link">Awards and recognition</a>
                <a href="#structure" class="link">Organizational structure</a>
              </nav>
            </div>
          </div>

          <div class="content">
            <div id="history" class="about-record">
              <div class="folio-rule-header">
                <h2 class="folio-rule-header__title">Our history.</h2>
              </div>
              <div class="prose-content">
                <p>
                  Friends of Ute Valley Park formed in 2012 when neighbors learned the City of Colorado Springs had an opportunity to purchase an additional 205 acres to expand the park through the Trails, Open Spaces, and Parks (TOPS) program.
                </p>
                <p>
                  Working alongside the Trust for Public Land and TOPS, FUVP raised $110,000 in three and a half months to help fund the land purchase. The city finalized the acquisition between 2014 and 2015, bringing Ute Valley Park to roughly 550 acres.
                </p>
              </div>
            </div>

            <div id="stewardship" class="about-record">
              <div class="folio-rule-header">
                <h2 class="folio-rule-header__title">How we care for the park.</h2>
              </div>
              <ol class="stewardship-grid">
                {
                  stewardshipWork.map((item) => (
                    <li class="stewardship-card">
                      <p>{item}</p>
                    </li>
                  ))
                }
              </ol>
            </div>

            <div id="awards" class="about-record">
              <div class="folio-rule-header">
                <h2 class="folio-rule-header__title">Awards and recognition.</h2>
              </div>
              <dl class="award-list">
                {
                  awards.map((award) => (
                    <div class="award-item">
                      <dt>{award.year}</dt>
                      <dd>{award.title}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>

            <div id="structure" class="about-record">
              <div class="folio-rule-header">
                <h2 class="folio-rule-header__title">Organizational structure.</h2>
              </div>
              <div class="structure-card editorial-folio">
                <p class="structure-summary">
                  Friends of Ute Valley Park is an independent 501(c)(3) public charity governed by a volunteer board and focused exclusively on maintaining, preserving, and protecting Ute Valley Park.
                </p>
                <dl class="structure-facts">
                  <div>
                    <dt>Tax status</dt>
                    <dd>Independent 501(c)(3) public charity</dd>
                  </div>
                  <div>
                    <dt>Charity EIN</dt>
                    <dd>42-2107142</dd>
                  </div>
                  <div>
                    <dt>Mailing address</dt>
                    <dd>PO Box 50122, Colorado Springs, CO 80919</dd>
                  </div>
                </dl>
                <div class="structure-links">
                  <a href="/about/official-organization-domain/" class="text-link">
                    View official domain and IRS verification →
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <TeamList />

    <!-- Archival Photos & Survey Report -->
    <section class="about-gallery page-section">
      <div class="page-section__inner gallery-stack">
        <div class="folio-rule-header gallery-intro">
          <h2 class="folio-rule-header__title">Park archives and geology.</h2>
          <p class="folio-rule-header__deck">
            Before residential neighborhoods grew along the western bluffs, ranching, coal mining, and sandstone formations shaped Ute Valley.
          </p>
        </div>

        <OldPhotos />

        <article class="survey-report editorial-folio">
          <div class="survey-media">
            <Picture
              src={SurveyPreview}
              formats={["avif"]}
              fallbackFormat="webp"
              alt="1983 El Paso County inactive coal mine survey map preview"
              width={800}
              height={450}
              widths={[400, 800, 1200]}
              sizes="(min-width: 64rem) 44vw, 94vw"
              class="survey-img"
            />
          </div>
          <div class="survey-copy">
            <h3>1983 Coal Mine Survey Report</h3>
            <p>
              Historical Colorado Front Range inactive coal mine survey covering subsurface conditions and past mining activity beneath El Paso County open spaces.
            </p>
            <a
              href="/images/maps/colorado-springs-coal-mine-survey.pdf"
              download
              class="button button--brand"
            >
              Download PDF report (14.8 MB)
            </a>
          </div>
        </article>
      </div>
    </section>

    <LeaveNoTraceSmall />
  </div>
</Layout>

<script>
  function initAboutToc() {
    const toc = document.querySelector<HTMLElement>("[data-about-toc]");
    if (!toc || toc.dataset.bound === "true") return;
    toc.dataset.bound = "true";

    const links = Array.from(
      toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'),
    );
    const linkById = new Map<string, HTMLAnchorElement>();
    for (const link of links) {
      const href = link.getAttribute("href");
      const id = href ? href.slice(1) : "";
      if (id) linkById.set(id, link);
    }

    const setActive = (id: string) => {
      for (const link of links) {
        link.classList.remove("active");
        link.removeAttribute("aria-current");
      }
      const active = linkById.get(id);
      if (active) {
        active.classList.add("active");
        active.setAttribute("aria-current", "location");
      }
    };

    const sections = Array.from(linkById.keys())
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => section !== null);

    if (sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setActive(entry.target.id);
          }
        },
        { rootMargin: "-28% 0px -65% 0px", threshold: 0 },
      );

      for (const section of sections) observer.observe(section);

      const requestedId = location.hash.slice(1);
      setActive(linkById.has(requestedId) ? requestedId : sections[0].id);
    }
  }

  initAboutToc();
  document.addEventListener("astro:page-load", initAboutToc);
</script>

<style>
  .about-emblem-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--color-border-muted);
    padding-top: 1rem;
  }

  .about-emblem-img {
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }

  .about-emblem-row p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body-small);
    font-weight: 500;
    line-height: 1.45;
  }

  .about-hero-plate {
    aspect-ratio: 4 / 3;
  }

  .about-hero-plate :global(picture),
  .about-hero-plate :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }

  .about-records {
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }

  .about-records .layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .toc-title {
    margin: 0 0 0.75rem;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .about-toc .links {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  .about-toc .link {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    border-bottom: 1px solid var(--color-border-muted);
    color: var(--color-text-muted);
    font-size: var(--text-body-small);
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .about-toc .link:hover,
  .about-toc .link.active {
    border-bottom-color: var(--color-brand-strong);
    color: var(--color-brand-strong);
  }

  .about-records .content {
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  .about-record {
    scroll-margin-top: 6rem;
  }

  .stewardship-grid {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    background: var(--color-border);
    list-style-position: inside;
  }

  .stewardship-card {
    background: var(--color-surface);
    padding: 1.25rem 1.5rem;
    color: var(--color-text-strong);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .stewardship-card p {
    display: inline;
    margin: 0;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .award-list {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .award-item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    border-bottom: 1px solid var(--color-border-muted);
    padding-block: 1rem;
    align-items: baseline;
  }

  .award-item dt {
    color: var(--color-brand-strong);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .award-item dd {
    margin: 0;
    color: var(--color-text-strong);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .structure-card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .structure-summary {
    max-width: 56ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body-large);
    line-height: 1.6;
  }

  .structure-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--color-border);
    background: var(--color-border);
  }

  .structure-facts > div {
    background: var(--color-page);
    padding: 1rem 1.25rem;
  }

  .structure-facts dt {
    color: var(--color-text-muted);
    font-size: var(--text-body-small);
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .structure-facts dd {
    margin: 0;
    color: var(--color-text-strong);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .gallery-stack {
    display: grid;
    gap: 3rem;
  }

  .gallery-intro {
    margin-bottom: 0;
  }

  .survey-report {
    display: grid;
    overflow: hidden;
  }

  .survey-media {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--color-border-strong);
    background: var(--color-surface-muted);
  }

  .survey-media :global(picture),
  .survey-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .survey-copy {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .survey-copy h3 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
  }

  .survey-copy p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (min-width: 64rem) {
    .about-records .layout {
      grid-template-columns: minmax(14rem, 3fr) minmax(0, 9fr);
      align-items: start;
    }

    .about-toc .sticky {
      position: sticky;
      top: 6rem;
    }

    .survey-report {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    }

    .survey-media {
      border-right: 1px solid var(--color-border-strong);
      border-bottom: 0;
    }
  }
</style>
