---
import Layout from "@layouts/Layout.astro";

const logos = [
  {
    src: "/images/logo-small.jpg",
    width: 200,
    height: 195,
    alt: "Small utility logo",
    desc: "Compact square seal suitable for avatars and badges.",
  },
  {
    src: "/images/logo-medium.jpg",
    width: 500,
    height: 488,
    alt: "Medium logo",
    desc: "Medium-format seal for newsletters, flyers, and web embeds.",
  },
  {
    src: "/images/logo-full.jpg",
    width: 1068,
    height: 1042,
    alt: "Full-size logo",
    desc: "Standard full-resolution JPG emblem for general publication.",
  },
  {
    src: "/images/logo-full-uncompressed.jpg",
    width: 1068,
    height: 1042,
    alt: "Uncompressed source logo",
    desc: "Minimal-compression JPG master file for print and kiosk signage.",
  },
  {
    src: "/images/logo-stickers.png",
    width: 1181,
    height: 1181,
    alt: "Sticker-cut PNG logo",
    desc: "Transparent-edge PNG layout sized for decals and community gear.",
  },
];
---

<Layout
  title="Assets"
  description="Download official Friends of Ute Valley Park brand assets and logos for approved community, partner, and media use."
>
  <div class="page assets-page">
    <!-- Masthead Utility Hero -->
    <section class="subpage-hero" aria-labelledby="assets-hero-title">
      <div class="subpage-hero__inner">
        <div class="subpage-hero__masthead">
          <div class="subpage-hero__split subpage-hero__split--masthead">
            <div class="subpage-hero__copy">
              <h1 id="assets-hero-title" class="subpage-hero__title">
                Brand assets.
              </h1>
              <p class="subpage-hero__deck">
                Official visual markers and logos for authorized partner communications, trailhead signage, community events, and media reporting.
              </p>
            </div>

            <aside class="subpage-hero__aside-box" aria-label="Asset usage">
              <h2 class="subpage-hero__aside-title">Usage questions</h2>
              <ul class="subpage-hero__aside-list">
                <li>JPG and PNG masters included</li>
                <li>
                  <a href="/contact/" class="text-link">Ask about partner usage →</a>
                </li>
              </ul>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Assets Grid -->
    <section class="page-section page-section--surface">
      <div class="page-section__inner">
        <div class="assets-grid">
          {
            logos.map((logo) => (
              <article class="asset-card editorial-folio">
                <div class="media">
                  <img
                    src={logo.src}
                    alt={logo.alt}
                    width={logo.width}
                    height={logo.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="body">
                  <div>
                    <h2>{logo.alt}</h2>
                    <p class="dims">{logo.width} × {logo.height} px</p>
                    <p class="desc">{logo.desc}</p>
                  </div>
                  <div>
                    <a href={logo.src} download class="button button--quiet">
                      Download file
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .assets-grid {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .asset-card {
    display: flex;
    flex-direction: column;
  }

  .asset-card .media {
    display: flex;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--color-border-strong);
    background: var(--color-page);
    padding: 2.5rem;
  }

  .asset-card .media img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
  }

  .asset-card .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .asset-card .body h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .asset-card .dims {
    margin: 0.25rem 0 0;
    color: var(--color-brand-strong);
    font-size: var(--text-body-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .asset-card .desc {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-body-small);
    line-height: 1.55;
  }

  @media (min-width: 48rem) {
    .assets-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .assets-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
