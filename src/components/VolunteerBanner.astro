---
import HeroiconsArrowRight from "~icons/heroicons/arrow-right";
import { getVolunteerBannerRenderModel, type VolunteerEventSummary } from "@/utils/volunteerBanner";

interface Props {
  events: VolunteerEventSummary[];
}

const { events } = Astro.props;
const { hasUpcomingVolunteerEvent, eventSchedule } = getVolunteerBannerRenderModel(events);
---

{
  hasUpcomingVolunteerEvent && (
    <div class="volunteer-alert">
      <div class="inner l-container">
        <div class="content">
          <div class="message">
            <span class="marker" aria-hidden="true"></span>
            <p>
              Upcoming volunteer workday: <span>{eventSchedule}</span>
            </p>
          </div>

          <a href="/volunteer/" class="link">
            <span>View volunteer schedule</span>
            <HeroiconsArrowRight class="icon" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  )
}

<style>
  .volunteer-alert {
    position: relative;
    z-index: 40;
    border-bottom: 1px solid var(--color-brand);
    background: var(--color-brand-strong);
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }

  .volunteer-alert .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 0.625rem;
  }

  .volunteer-alert .message {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .volunteer-alert .marker {
    display: block;
    width: 0.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    background: var(--color-accent);
  }

  .volunteer-alert .message p {
    margin: 0;
    color: var(--color-text-inverse);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 600;
    line-height: 1.4;
  }

  .volunteer-alert .message span {
    color: var(--color-brand-muted);
    font-weight: 500;
  }

  .volunteer-alert .link {
    display: inline-flex;
    min-height: 2.375rem;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid color-mix(in oklab, var(--color-text-inverse) 28%, transparent);
    background: var(--color-surface);
    color: var(--color-brand-strong);
    padding: 0.375rem 1rem;
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: var(--shadow-accent-sm);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .volunteer-alert .link:hover {
    background: var(--color-accent);
    color: var(--color-text);
    transform: translate(-2px, -2px);
  }

  .volunteer-alert .link:active {
    transform: scale(0.98);
  }

  .volunteer-alert .icon {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .volunteer-alert .link:hover .icon {
    transform: translateX(0.2rem);
  }

  @media (min-width: 48rem) {
    .volunteer-alert .content {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
