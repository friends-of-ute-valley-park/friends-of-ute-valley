---
const stats = [
  { id: 1, name: "Volunteers who pitched in", value: "76" },
  { id: 2, name: "Volunteer hours logged on trails", value: "331" },
  { id: 3, name: "Community stewardship workdays", value: "7" },
  { id: 4, name: "Neighbors following along on Instagram", value: "2,500" },
];

import { Picture } from "astro:assets";
import Volunteers from "@/assets/images/volunteer-6.jpg";
---

<div class="impact-stats">
  <div class="layout">
    <div class="media">
      <Picture
        src={Volunteers}
        formats={["avif"]}
        fallbackFormat="webp"
        alt="Ute Valley Park volunteers walking a wooded trail carrying tools"
        class="image media-cover"
        width={800}
        widths={[400, 800, 1200]}
        sizes="(min-width: 64rem) 50vw, 100vw"
      />
    </div>

    <div class="content">
      <div class="stack">
        <div class="folio-rule-header heading">
          <h2 class="folio-rule-header__title">
            Our 2025 trail impact.
          </h2>
          <p class="folio-rule-header__deck">
            Everything accomplished in Ute Valley Park comes directly from neighbors showing up with gloves, tools, and time.
          </p>
        </div>

        <dl class="grid feature-grid">
          {
            stats.map((stat) => (
              <div class="stat">
                <dd>{stat.value}</dd>
                <dt>{stat.name}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</div>

<style>
  .impact-stats {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }

  .impact-stats .layout {
    display: grid;
  }

  .impact-stats .media {
    position: relative;
    min-height: 20rem;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .impact-stats .media :global(picture),
  .impact-stats .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .impact-stats .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.75rem, 4vw, 3.25rem);
  }

  .impact-stats .stack {
    display: grid;
    gap: 2rem;
  }

  .impact-stats .heading {
    margin-bottom: 0;
  }

  .impact-stats .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    --feature-grid-border-color: var(--color-border);
    --feature-grid-background: var(--color-border);
  }

  .impact-stats .stat {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    background: var(--color-surface);
    padding: 1.25rem;
  }

  .impact-stats .stat dd {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .impact-stats .stat dt {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 500;
    line-height: 1.4;
  }

  @media (min-width: 64rem) {
    .impact-stats .layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .impact-stats .media {
      height: auto;
      border-right: 1px solid var(--color-border-strong);
      border-bottom: 0;
    }
  }
</style>
