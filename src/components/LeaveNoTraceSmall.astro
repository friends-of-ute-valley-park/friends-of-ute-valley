---
import { Image } from "astro:assets";
import EngagementPanel from "./EngagementPanel.astro";
import lntLogo from "../assets/images/logos/leave-no-trace.png";
---

<div class="lnt-small">
  <EngagementPanel>
    <h2 slot="heading" class="title section-heading__title">
      Leave No Trace in Ute Valley Park.
    </h2>
    <Fragment slot="description">
      <p class="description section-heading__copy">
        Ute Valley Park proudly follows The 7 Principles of Leave No Trace. Simple daily habits help protect exposed sandstone ridges, ponderosa roots, and Front Range wildlife.
      </p>
      <div class="rules">
        <a href="/rules/" class="rules-link">
          View park rules and hours →
        </a>
      </div>
    </Fragment>

    <div slot="main" class="partner">
      <a href="https://www.lnt.org" target="_blank" rel="noopener noreferrer nofollow" class="logo-link">
        <Image
          src={lntLogo}
          format="png"
          width={192}
          densities={[1, 2]}
          alt="Leave No Trace Gold Standard Site logo"
          class="logo"
        />
      </a>
      <span>Leave No Trace Gold Standard Site partner (opens lnt.org)</span>
    </div>
  </EngagementPanel>
</div>

<style>
  .lnt-small .description {
    margin: 0;
    color: var(--color-text-inverse-muted);
    font-family: var(--font-body);
    font-size: var(--text-body-large);
    font-weight: 400;
    line-height: 1.6;
  }

  .lnt-small .rules {
    padding-top: 0.75rem;
  }

  .lnt-small .rules-link {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    color: var(--color-text-inverse);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3rem;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .lnt-small .rules-link:hover {
    color: var(--color-accent);
  }

  .lnt-small .partner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding-block: 1rem;
    text-align: center;
  }

  .lnt-small .logo-link {
    display: block;
  }

  :global(.lnt-small .logo) {
    width: 12rem;
    height: auto;
  }

  .lnt-small .partner span {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 500;
    line-height: 1.45;
  }
</style>
