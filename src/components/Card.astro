---
export interface Props {
  title: string;
  image: ImageMetadata;
  previewText: string;
  href: string;
  publishedOn: Date;
}

const { title, image, publishedOn, href, previewText } = Astro.props;

import { Picture } from "astro:assets";
import { formatShortMonthDayYear } from "@/utils/date";
---

<a href={"/news/" + href} class="news-teaser">
  <article class="news-teaser__card">
    <div class="media media-frame media-zoom-frame">
      <Picture
        src={image}
        formats={["avif"]}
        fallbackFormat="webp"
        width={480}
        height={300}
        widths={[480, 720]}
        sizes="(min-width: 64rem) 30vw, (min-width: 48rem) 45vw, 100vw"
        alt={title}
        class="image media-cover media-zoom"
      />
    </div>

    <div class="body">
      <time class="date" datetime={publishedOn.toISOString()}>
        {formatShortMonthDayYear(publishedOn)}
      </time>
      <h3 class="title card-title">
        {title}
      </h3>
      <p class="preview">
        {previewText}
      </p>
      <span class="read-link">Read dispatch →</span>
    </div>
  </article>
</a>

<style>
  .news-teaser {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .news-teaser__card {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 1.125rem;
  }

  .news-teaser .media {
    position: relative;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface-muted);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .news-teaser:hover .media {
    border-color: var(--color-brand-strong);
  }

  .news-teaser :global(picture),
  .news-teaser :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .news-teaser .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
  }

  .news-teaser .date {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .news-teaser:hover .title {
    color: var(--color-brand-strong);
  }

  .news-teaser .preview {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 400;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .news-teaser .read-link {
    margin-top: auto;
    padding-top: 0.375rem;
    color: var(--color-brand-strong);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25rem;
  }
</style>
