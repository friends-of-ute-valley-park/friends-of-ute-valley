---
import { Picture } from "astro:assets";

const teamMembers = [
  {
    name: "Drew Town",
    title: "Chair",
    image: import("@/assets/images/members/drew-town.jpg"),
  },
  {
    name: "Christine Thomas",
    title: "Vice-Chair",
    image: import("@/assets/images/members/christine-thomas.jpg"),
  },
  {
    name: "Megan Town",
    title: "Treasurer",
    image: import("@/assets/images/members/megan-town.jpg"),
  },
  {
    name: "Katie Gray",
    title: "Secretary & Nature and Trail Specialist",
    image: import("@/assets/images/members/katie-gray.jpg"),
  },
  {
    name: "Phill Emmert",
    title: "Communications",
    image: import("@/assets/images/members/phill-emmert.jpg"),
  },
  {
    name: "Haley Kline Murphy",
    title: "Education and Stewardship Coordinator",
    image: import("@/assets/images/members/haley-kline-murphy.jpg"),
  },
  {
    name: "Pete Galeotti",
    title: "Outreach and Engagement Specialist",
    image: import("@/assets/images/members/pete-galeotti.jpg"),
  },
  {
    name: "Nadine Lambert",
    title: "Volunteer Coordinator",
    image: import("@/assets/images/members/nadine-lambert.jpg"),
  },
  {
    name: "Jake Nixon",
    title: "Historian",
    image: import("@/assets/images/members/jake-nixon.jpg"),
  },
];
---

<div class="team-list">
  <div class="inner l-container">
    <div class="folio-rule-header">
      <h2 class="folio-rule-header__title">Meet the volunteer board.</h2>
      <p class="folio-rule-header__deck">
        Every board role at Friends of Ute Valley Park is filled by an unpaid neighbor helping coordinate trail days, outreach, and park advocacy.
      </p>
    </div>

    <div class="grid feature-grid feature-grid--two-sm feature-grid--three">
      {
        teamMembers.map((teamMember) => (
          <div class="card-cell media-zoom-parent">
            <div class="media">
              <Picture
                src={teamMember.image}
                formats={["avif"]}
                fallbackFormat="webp"
                alt={teamMember.name}
                width={540}
                height={540}
                widths={[400, 540, 800]}
                sizes="(min-width: 100rem) 540px, (min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                class="image media-cover media-zoom"
              />
            </div>
            <div class="body">
              <h3 class="name card-title">
                {teamMember.name}
              </h3>
              <p class="role">
                {teamMember.title}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .team-list {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding-block: clamp(3.5rem, 6vw, 5rem);
    font-family: var(--font-body);
  }

  .team-list .card-cell {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
  }

  .team-list .media {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    overflow: hidden;
    background: var(--color-surface-muted);
  }

  .team-list .media :global(picture),
  .team-list .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .team-list .media :global(img) {
    object-position: 50% 25%;
  }

  .team-list .body {
    display: grid;
    gap: 0.375rem;
    border-top: 1px solid var(--color-border-muted);
    padding: 1.25rem 1.5rem;
  }

  .team-list .name {
    --card-title-size: 1.25rem;
  }

  .team-list .role {
    margin: 0;
    color: var(--color-brand-strong);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 600;
    line-height: 1.4;
  }
</style>
