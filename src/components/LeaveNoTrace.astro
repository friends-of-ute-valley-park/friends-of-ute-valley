---
import { Image, Picture } from "astro:assets";
import PlanAhead from "../assets/images/lnt/plan-ahead-and-prepare.jpg";
import TravelOnDurableSurfaces from "../assets/images/lnt/travel-on-durable-surfaces.jpg";
import DisposeOfWasteProperly from "../assets/images/lnt/dispose-of-waste-properly.jpg";
import LeaveWhatYouFind from "../assets/images/lnt/leave-what-you-find.jpg";
import RespectWildlife from "../assets/images/lnt/respect-wildlife.jpg";
import BeConsiderateOfOtherVisitors from "../assets/images/lnt/be-considerate-of-other-visitors.jpg";
import lntLogo from "../assets/images/logos/leave-no-trace.png";

const principles = [
  {
    name: "Plan ahead and prepare",
    text: "Check the forecast, plan your route, and review the <a class='text-link' href='/rules/'>park rules</a> before heading out.",
    image: PlanAhead,
    altText: "A lone ponderosa pine in golden grassland under a blue sky",
  },
  {
    name: "Travel on durable surfaces",
    text: "<a class='text-link' href='/leavenotrace/travel-on-durable-surfaces/'>Stay on designated trails</a> to protect the landscape around you. Stick to marked paths and respect Natural Preservation Area closures so plants and soil can thrive.",
    image: TravelOnDurableSurfaces,
    altText: "A sandy trail climbing between pines and scrub oak",
  },
  {
    name: "Dispose of waste properly",
    text: "Follow a pack-in, pack-out approach and carry out everything you bring, including <a class='text-link' href='/leavenotrace/dogs/'>pet waste</a>, to trailhead bins.",
    image: DisposeOfWasteProperly,
    altText: "A discarded plastic bottle on a dirt trail through dry grass",
  },
  {
    name: "Leave what you find",
    text: "Take photos, leave natural features intact. <a class='text-link' href='/leavenotrace/leave-what-you-find/'>Snap all the pictures you like</a>, while leaving rocks, wildflowers, and historic sites undisturbed for others.",
    image: LeaveWhatYouFind,
    altText: "Backlit flowers glowing in low evening sun",
  },
  {
    name: "Respect wildlife",
    text: "Observe all wildlife from a safe distance and never feed them. Keep dogs on leash to protect wildlife habitat and review our <a class='text-link' href='/leavenotrace/respect-wildlife/'>wildlife guidelines</a>.",
    image: RespectWildlife,
    altText: "A deer among scrub oak and pines with the foothills beyond",
  },
  {
    name: "Be considerate of other visitors",
    text: "Yield thoughtfully, keep noise levels down, and share singletrack trails so everyone can enjoy their time in the park.",
    image: BeConsiderateOfOtherVisitors,
    altText: "Three hikers pausing on a snowy trail among pines",
  },
];

const onRulesPage = Astro.url.pathname.replace(/\/$/, "") === "/rules";
---

<section class="lnt-principles" aria-labelledby="lnt-title">
  <div class="inner">
    <div class="layout">
      <div class="intro">
        <div class="intro-sticky">
          <div class="intro-copy folio-rule-header">
            <h2 id="lnt-title" class="title folio-rule-header__title">
              Leave No Trace.
            </h2>

            <p class="summary folio-rule-header__deck">
              Ute Valley Park is a designated Leave No Trace Gold Standard Site. Help keep the park healthy for wildlife and neighbors by following these everyday stewardship principles.
            </p>
          </div>

          <div class="partner">
            <a
              class="logo-card"
              href="https://www.lnt.org"
              target="_blank"
              rel="noopener noreferrer nofollow"
            >
              <Image
                src={lntLogo}
                format="png"
                width={192}
                densities={[1, 2]}
                alt="Leave No Trace Gold Standard Site"
                class="logo"
              />
              <span class="certification">
                Certified Gold Standard Partner
                <span class="sr-only">(opens lnt.org in a new tab)</span>
              </span>
            </a>

            {
              !onRulesPage && (
                <a href="/rules/" class="button button--brand rules-link">
                  Read park rules
                </a>
              )
            }
          </div>
        </div>
      </div>

      <ol class="list">
        {
          principles.map((principle, index) => (
            <li class="card-cell">
              <div class="card-head">
                <span class="principle-step">Principle {index + 1}</span>
                <h3>{principle.name}</h3>
              </div>

              <div class="media media-frame">
                <Picture
                  class="image media-cover"
                  src={principle.image}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  alt={principle.altText}
                  width={400}
                  height={250}
                  widths={[400, 640]}
                  sizes="(min-width: 64rem) 28vw, (min-width: 48rem) 45vw, 100vw"
                />
              </div>

              <p class="copy" set:html={principle.text} />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .lnt-principles {
    overflow: clip;
    border-top: 1px solid var(--color-border);
    background: var(--color-page);
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }

  .lnt-principles .inner {
    max-width: var(--container-wide);
    margin-inline: auto;
  }

  .lnt-principles .layout {
    display: grid;
  }

  .lnt-principles .intro {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: clamp(2rem, 5vw, 4rem);
  }

  .lnt-principles .intro-sticky {
    display: grid;
    gap: 2rem;
  }

  .lnt-principles .intro-copy {
    margin-bottom: 0;
  }

  .lnt-principles .partner {
    display: grid;
    gap: 1.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }

  .lnt-principles .logo-card {
    display: grid;
    justify-items: center;
    gap: 1rem;
    border: 1px solid var(--color-border-strong);
    background: var(--color-page);
    padding: 1.75rem 1.5rem 1.25rem;
    color: var(--color-brand-strong);
    text-decoration: none;
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .lnt-principles .logo-card:hover {
    box-shadow: var(--shadow-accent-sm);
    transform: translate(-2px, -2px);
  }

  .lnt-principles .logo-card:active {
    transform: scale(0.98);
  }

  :global(.lnt-principles .logo) {
    display: block;
    width: 100%;
    max-width: 11.5rem;
    height: auto;
  }

  .lnt-principles .certification {
    width: 100%;
    border-top: 1px solid var(--color-border-muted);
    padding-top: 0.875rem;
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 600;
    text-align: center;
  }

  .lnt-principles .rules-link {
    display: flex;
  }

  .lnt-principles .list {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    background: var(--color-border);
    list-style: none;
  }

  .lnt-principles .card-cell {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--color-page);
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  .lnt-principles .card-head {
    display: grid;
    gap: 0.25rem;
  }

  .lnt-principles .principle-step {
    color: var(--color-brand-strong);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .lnt-principles .card-cell h3 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.015em;
  }

  .lnt-principles .media {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-border-strong);
  }

  .lnt-principles .media :global(picture),
  .lnt-principles .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lnt-principles .copy {
    max-width: 58ch;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
  }

  @media (min-width: 48rem) {
    .lnt-principles .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lnt-principles .card-cell h3 {
      min-block-size: 2lh;
    }
  }

  @media (min-width: 64rem) {
    .lnt-principles .layout {
      grid-template-columns: 4fr 8fr;
    }

    .lnt-principles .intro {
      border-right: 1px solid var(--color-border);
      border-bottom: 0;
    }

    .lnt-principles .intro-sticky {
      position: sticky;
      top: 6rem;
    }
  }
</style>
