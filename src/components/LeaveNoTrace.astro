---
import { Picture } from "astro:assets";
import PlanAhead from "../assets/images/lnt/plan-ahead-and-prepare.jpg";
import TravelOnDurableSurfaces from "../assets/images/lnt/travel-on-durable-surfaces.jpg";
import DisposeOfWasteProperly from "../assets/images/lnt/dispose-of-waste-properly.jpg";
import LeaveWhatYouFind from "../assets/images/lnt/leave-what-you-find.jpg";
import RespectWildlife from "../assets/images/lnt/respect-wildlife.jpg";
import BeConsiderateOfOtherVisitors from "../assets/images/lnt/be-considerate-of-other-visitors.jpg";

const principles = [
  {
    id: "01",
    name: "Plan Ahead & Prepare",
    text: "A little preparation goes a long way! Check the forecast, plan your route, and review the <a class='text-link' href='/rules/'>park rules</a> before heading out.",
    image: PlanAhead,
    altText: "A lone ponderosa pine in golden grassland under a blue sky",
  },
  {
    id: "02",
    name: "Travel on Durable Surfaces",
    text: "<a class='text-link' href='/leavenotrace/travel-on-durable-surfaces/'>Stay on the trail</a> to protect the landscape around you. Stick to marked paths and respect Natural Preservation Area closures so plants and soil can thrive.",
    image: TravelOnDurableSurfaces,
    altText: "A sandy trail climbing between pines and scrub oak",
  },
  {
    id: "03",
    name: "Dispose of Waste Properly",
    text: "Follow a Pack-In, Pack-Out approach — carry out everything you carry in, including <a class='text-link' href='/leavenotrace/dogs/'>pet waste</a>. This keeps Ute Valley Park looking (and smelling) bea-UTE-iful!",
    image: DisposeOfWasteProperly,
    altText: "A discarded plastic bottle on a dirt trail through dry grass",
  },
  {
    id: "04",
    name: "Leave What You Find",
    text: "Take only photos, leave only footprints! <a class='text-link' href='/leavenotrace/leave-what-you-find/'>Snap all the pictures you like</a>, but please leave rocks, plants, and other natural treasures for the next visitor to enjoy.",
    image: LeaveWhatYouFind,
    altText: "Backlit flowers glowing in low evening sun",
  },
  {
    id: "05",
    name: "Respect Wildlife",
    text: "Observe all wildlife from a safe distance and never feed them. Keep dogs on leash to protect wildlife habitat — learn more about our <a class='text-link' href='/leavenotrace/respect-wildlife/'>leash guidelines</a>.",
    image: RespectWildlife,
    altText: "A deer among scrub oak and pines with the foothills beyond",
  },
  {
    id: "06",
    name: "Be Considerate of Other Visitors",
    text: "A friendly hello goes a long way! Yield to other trail users, keep noise levels down, and share the trail so everyone can have a great time in the park.",
    image: BeConsiderateOfOtherVisitors,
    altText: "Three hikers pausing on a snowy trail among pines",
  },
];

import lntLogo from "../assets/images/logos/leave-no-trace.png";

const onRulesPage = Astro.url.pathname.replace(/\/$/, "") === "/rules";
---

<section class="lnt-principles" aria-labelledby="lnt-title">
  <div class="inner">
    <div class="layout">
      <div class="intro">
        <div class="intro-sticky">
          <div class="intro-copy section-heading">
            <h2 id="lnt-title" class="title section-heading__title">
              Leave <br /> No <br />
              <span>Trace.</span>
            </h2>

            <p class="summary section-heading__copy">
              Ute Valley Park is a treasured urban wildland. Please help keep
              the park safe and clean for all visitors by following Leave No
              Trace guidance.
            </p>
          </div>

          <div class="partner">
            <a
              class="logo-card"
              href="https://www.lnt.org"
              target="_blank"
              rel="noopener noreferrer nofollow"
            >
              <Picture
                src={lntLogo}
                formats={["png"]}
                densities={[1, 2]}
                width={240}
                alt="Leave No Trace Gold Standard Site"
                class="logo"
              />
              <span class="certification">
                Certified Partner
                <span class="sr-only">(opens lnt.org in a new tab)</span>
              </span>
            </a>

            {
              !onRulesPage && (
                <a href="/rules/" class="button button--brand rules-link">
                  View Park Rules
                </a>
              )
            }
          </div>
        </div>
      </div>

      <ol class="list">
        {
          principles.map((principle) => (
            <li class="card">
              <div class="card-head">
                <span class="number" aria-hidden="true">{principle.id}</span>
                <h3>
                  <span class="sr-only">Principle {Number(principle.id)}: </span>
                  {principle.name}
                </h3>
              </div>

              <div class="media media-frame">
                <Picture
                  class="image media-cover"
                  src={principle.image}
                  alt={principle.altText}
                  width={600}
                />
              </div>

              <p class="copy" set:html={principle.text} />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .lnt-principles {
    overflow: clip;
    border-top: 1px solid var(--color-border);
    background: var(--color-page);
  }

  .lnt-principles .inner {
    max-width: var(--container-wide);
    margin-inline: auto;
  }

  .lnt-principles .layout {
    display: grid;
  }

  .lnt-principles .intro {
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-surface-muted) 50%, transparent);
    padding: clamp(2rem, 5vw, 4rem);
  }

  .lnt-principles .intro-sticky {
    display: grid;
    gap: 2.5rem;
  }

  .lnt-principles .intro-copy {
    --section-heading-gap: 1.5rem;
    --section-heading-title-size: clamp(3rem, 8vw, 3.75rem);
    --section-heading-accent-style: normal;
    --section-heading-copy-margin: 0;
  }

  .lnt-principles .partner {
    display: grid;
    gap: 1.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
  }

  .lnt-principles .logo-card {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    border: 2px solid var(--color-brand-strong);
    background: var(--color-surface);
    padding: 2rem 1.5rem 1.5rem;
    color: var(--color-brand-strong);
    text-decoration: none;
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .lnt-principles .logo-card:hover {
    box-shadow: var(--shadow-accent-sm);
    transform: translate(-0.25rem, -0.25rem);
  }

  .lnt-principles .logo-card:active {
    transform: scale(0.98);
  }

  :global(.lnt-principles .logo) {
    display: block;
    width: 100%;
    max-width: 12rem;
    height: auto;
  }

  .lnt-principles .certification {
    width: 100%;
    border-top: 1px solid var(--color-border-muted);
    padding-top: 1rem;
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 900;
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-transform: uppercase;
  }

  .lnt-principles .rules-link {
    display: flex;
  }

  .lnt-principles .list {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    background: var(--color-border);
    list-style: none;
  }

  .lnt-principles .card {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    background: var(--color-page);
    padding: clamp(2rem, 4vw, 3rem);
  }

  .lnt-principles .card-head {
    display: grid;
    gap: 0.75rem;
  }

  .lnt-principles .number {
    color: var(--color-accent-strong);
    font-family: var(--font-label);
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .lnt-principles .card h3 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .lnt-principles .media {
    aspect-ratio: 16 / 10;
    --media-frame-border-color: var(--color-border-muted);
  }

  .lnt-principles .copy {
    max-width: 60ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: var(--leading-body);
  }

  @media (min-width: 48rem) {
    .lnt-principles .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Two-line title slot keeps photos level across each row. */
    .lnt-principles .card h3 {
      min-block-size: 2lh;
    }
  }

  @media (min-width: 64rem) {
    .lnt-principles .layout {
      grid-template-columns: 4fr 8fr;
    }

    .lnt-principles .intro {
      border-right: 1px solid var(--color-border);
      border-bottom: 0;
    }

    .lnt-principles .intro-sticky {
      position: sticky;
      top: 7rem;
    }
  }
</style>
