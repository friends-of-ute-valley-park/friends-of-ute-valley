---
import { Picture } from "astro:assets";

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/old-ute-valley-park-photos/old-ute-*.jpg",
  { eager: true },
);

const sorted = Object.entries(allImages)
  .map(([path, mod]) => {
    const match = path.match(/old-ute-(\d+)\.jpg$/);
    return { num: match ? parseInt(match[1]) : 0, image: mod.default };
  })
  .sort((a, b) => a.num - b.num);

const initialPhotos = sorted.slice(0, 6);
const morePhotos = sorted.slice(6);
---

<div class="historic-photos">
  <div class="folio-rule-header header">
    <h3 class="heading-title">Historic park photographs.</h3>
  </div>

  <div class="grid feature-grid feature-grid--two-sm feature-grid--three">
    {
      initialPhotos.map(({ image, num }) => (
        <div class="item media-zoom-frame">
          <Picture
            src={image}
            alt={`Historic Ute Valley Park photo ${num}`}
            formats={["avif"]}
            fallbackFormat="webp"
            width={540}
            height={540}
            widths={[400, 540, 800]}
            sizes="(min-width: 100rem) 540px, (min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
            class="image media-cover media-zoom"
          />
        </div>
      ))
    }
  </div>

  <div id="view-more-btn" class="more">
    <button type="button" class="button button--outline" data-toggle-photos>
      View all {sorted.length} archival photos
    </button>
  </div>

  <div id="more-photos" class="extra" hidden>
    <div class="grid feature-grid feature-grid--two-sm feature-grid--three">
      {
        morePhotos.map(({ image, num }) => (
          <div class="item media-zoom-frame">
            <Picture
              src={image}
              alt={`Historic Ute Valley Park photo ${num}`}
              formats={["avif"]}
              fallbackFormat="webp"
              width={540}
              height={540}
              widths={[400, 540, 800]}
              sizes="(min-width: 100rem) 540px, (min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
              class="image media-cover media-zoom"
            />
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  function initOldPhotos() {
    const btn = document.querySelector<HTMLButtonElement>("[data-toggle-photos]");
    const btnWrapper = document.getElementById("view-more-btn");
    const morePhotos = document.getElementById("more-photos");

    btn?.addEventListener("click", () => {
      morePhotos?.removeAttribute("hidden");
      btnWrapper?.remove();
    });
  }

  initOldPhotos();
  document.addEventListener("astro:page-load", initOldPhotos);
</script>

<style>
  .historic-photos {
    display: grid;
    gap: 1.5rem;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }

  .historic-photos .header {
    margin-bottom: 0;
  }

  .historic-photos .heading-title {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .historic-photos .grid {
    --feature-grid-border-color: var(--color-border-strong);
    --feature-grid-background: var(--color-border-strong);
  }

  .historic-photos .item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-surface);
  }

  .historic-photos .item :global(picture),
  .historic-photos .item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .historic-photos .more {
    display: flex;
    justify-content: flex-start;
    padding-top: 0.5rem;
  }

  .historic-photos .extra {
    display: grid;
    gap: 1.5rem;
  }

  .historic-photos .extra[hidden] {
    display: none;
  }
</style>
