---
import { isDateInList } from "../utils/date";

type CalendarEventType = "public" | "company";

type CalendarEvent = {
  date: string;
  type: CalendarEventType;
  title: string;
  companyName?: string;
};

// Includes tentative dates before individual event entries are published.
const calendarEvents: CalendarEvent[] = [
  { date: "2026-05-20", type: "public", title: "Public volunteer event" },
  { date: "2026-06-03", type: "public", title: "Public volunteer event" },
  { date: "2026-06-17", type: "public", title: "Public volunteer event" },
  { date: "2026-07-08", type: "public", title: "Public volunteer event" },
  { date: "2026-07-15", type: "public", title: "Public volunteer event" },
  { date: "2026-08-05", type: "public", title: "Public volunteer event" },
  { date: "2026-08-19", type: "public", title: "Public volunteer event" },
  { date: "2026-09-02", type: "public", title: "Public volunteer event" },
  { date: "2026-09-19", type: "public", title: "Public volunteer event" },
  { date: "2026-10-31", type: "public", title: "Friends of Ute Valley Park Trail Work Volunteer Day" },
  {
    date: "2026-05-18",
    type: "company",
    title: "Company volunteer event",
    companyName: "Entegris",
  },
  {
    date: "2026-06-26",
    type: "company",
    title: "Company volunteer event",
    companyName: "Orthopedic Rehabilitation Associates",
  },
  {
    date: "2026-08-01",
    type: "company",
    title: "Company volunteer event",
    companyName: "Trail Sisters",
  },
];

const toLocalDate = (dateString: string) => {
  const [year, month, day] = dateString.split("-").map(Number);
  return new Date(year, month - 1, day);
};

const volunteerEventDates = calendarEvents.map((event) => toLocalDate(event.date));
const currentYear =
  calendarEvents.length > 0
    ? toLocalDate(calendarEvents[0].date).getFullYear()
    : new Date().getFullYear();
const allMonths = [
  { label: "April", monthIndex: 3 },
  { label: "May", monthIndex: 4 },
  { label: "June", monthIndex: 5 },
  { label: "July", monthIndex: 6 },
  { label: "August", monthIndex: 7 },
  { label: "September", monthIndex: 8 },
  { label: "October", monthIndex: 9 },
];

const eventMonthIndexes = volunteerEventDates.map((date) => date.getMonth());
const firstVisibleMonth =
  eventMonthIndexes.length > 0 ? Math.min(...eventMonthIndexes) : 3;
const lastVisibleMonth =
  eventMonthIndexes.length > 0 ? Math.max(...eventMonthIndexes) : 8;

const months = allMonths.filter(
  ({ monthIndex }) =>
    monthIndex >= firstVisibleMonth && monthIndex <= lastVisibleMonth,
);

const getDaysInMonth = (year: number, month: number) => {
  const dayCount = new Date(year, month + 1, 0).getDate();

  return Array.from(
    { length: dayCount },
    (_, dayIndex) => new Date(year, month, dayIndex + 1),
  );
};

const getCalendarEvent = (date: Date) =>
  calendarEvents.find((event) => isDateInList(date, [toLocalDate(event.date)]));

const getEventLabel = (event: CalendarEvent) =>
  event.companyName ? `${event.title}: ${event.companyName}` : event.title;
---

<div class="static-calendar l-container">
  <div class="folio-rule-header header-wrap">
    <div class="header">
      <h2 class="folio-rule-header__title">
        Posted workdays for {currentYear}.
      </h2>

      <div class="intro">
        <p class="intro-copy">
          Highlighted dates mark public volunteer sessions and company stewardship days. Company workdays are scheduled separately and are not open to public sign-up.
        </p>
        <div class="legend">
          <div>
            <span class="legend-swatch public" aria-hidden="true"></span>
            <span>Public volunteer workday</span>
          </div>
          <div>
            <span class="legend-swatch company" aria-hidden="true"></span>
            <span>Company stewardship day</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="months feature-grid feature-grid--two feature-grid--three-xl">
    {
      months.map(({ label, monthIndex }) => {
        const daysInMonth = getDaysInMonth(currentYear, monthIndex);
        const firstDayOfWeek = daysInMonth[0].getDay();

        return (
          <div class="month">
            <h3>{label}</h3>
            <div class="grid">
              {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map((day) => (
                <div class="weekday">{day}</div>
              ))}

              {Array.from({ length: firstDayOfWeek }).map(() => (
                <div class="day blank" />
              ))}

              {daysInMonth.map((day) => {
                const calendarEvent = getCalendarEvent(day);
                const isVolunteerDay = Boolean(calendarEvent);
                const isCompanyEvent = calendarEvent?.type === "company";
                const eventLabel = calendarEvent ? getEventLabel(calendarEvent) : undefined;

                return (
                  <div
                    class:list={[
                      "day",
                      !isVolunteerDay && "empty",
                      isVolunteerDay && !isCompanyEvent && "public",
                      isCompanyEvent && "company",
                    ]}
                    title={isCompanyEvent ? eventLabel : undefined}
                    aria-label={eventLabel}
                  >
                    <span
                      class:list={[
                        "day-number",
                        isVolunteerDay && !isCompanyEvent
                          ? "public"
                          : isCompanyEvent
                          ? "company"
                          : "empty",
                      ]}
                    >
                      {day.getDate()}
                    </span>
                    {isVolunteerDay && !isCompanyEvent && <div class="event-outline public" />}
                    {isCompanyEvent && <div class="event-outline company" />}
                  </div>
                );
              })}

              {Array.from({
                length: (7 - ((daysInMonth.length + firstDayOfWeek) % 7)) % 7,
              }).map(() => (
                <div class="day blank" />
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .static-calendar {
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }

  .static-calendar .header-wrap {
    margin-bottom: 2.25rem;
  }

  .static-calendar .header {
    display: grid;
    align-items: start;
    gap: 1.25rem 2.5rem;
  }

  .static-calendar .intro {
    display: grid;
    gap: 0.875rem;
  }

  .static-calendar .intro-copy {
    max-width: 52ch;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
  }

  .static-calendar .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }

  .static-calendar .legend div {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-strong);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 600;
  }

  .static-calendar .legend-swatch {
    width: 0.875rem;
    height: 0.875rem;
  }

  .static-calendar .legend-swatch.public {
    border: 2px solid var(--color-brand-strong);
    background: color-mix(in oklab, var(--color-brand) 16%, transparent);
  }

  .static-calendar .legend-swatch.company {
    border: 2px solid var(--color-accent-strong);
    background: color-mix(in oklab, var(--color-accent) 26%, transparent);
  }

  .static-calendar .months {
    --feature-grid-border-color: var(--color-border-strong);
    --feature-grid-background: var(--color-border-strong);
  }

  .static-calendar .month {
    background: var(--color-surface);
    padding: 1.5rem;
  }

  .static-calendar .month h3 {
    margin: 0 0 1rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .static-calendar .grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--color-border-muted);
    background: var(--color-border-muted);
  }

  .static-calendar .weekday {
    background: var(--color-page);
    color: var(--color-text-muted);
    padding-block: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 600;
    text-align: center;
  }

  .static-calendar .day {
    position: relative;
    display: flex;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
  }

  .static-calendar .day.blank,
  .static-calendar .day.empty {
    background: var(--color-surface);
  }

  .static-calendar .day.public {
    background: color-mix(in oklab, var(--color-brand) 10%, transparent);
  }

  .static-calendar .day.company {
    background: color-mix(in oklab, var(--color-accent) 20%, transparent);
  }

  .static-calendar .day-number {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-variant-numeric: tabular-nums;
  }

  .static-calendar .day-number.empty {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .static-calendar .day-number.public,
  .static-calendar .day-number.company {
    font-weight: 800;
  }

  .static-calendar .day-number.public {
    color: var(--color-brand-strong);
  }

  .static-calendar .day-number.company {
    color: var(--color-accent-strong);
  }

  .static-calendar .event-outline {
    position: absolute;
    inset: 0.1875rem;
    pointer-events: none;
  }

  .static-calendar .event-outline.public {
    border: 1px solid color-mix(in oklab, var(--color-brand-strong) 45%, transparent);
  }

  .static-calendar .event-outline.company {
    border: 1px solid color-mix(in oklab, var(--color-accent-strong) 65%, transparent);
  }

  @media (min-width: 64rem) {
    .static-calendar .header {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }
  }
</style>
