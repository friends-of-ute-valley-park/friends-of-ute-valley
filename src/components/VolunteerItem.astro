---
import type { VolunteerEventView } from '@/utils/EventData';

interface Props {
  volunteerEvent: VolunteerEventView;
}

const { volunteerEvent } = Astro.props;
---

<article class="volunteer-item">
  <div class="details">
    <h3 class="heading">
      <a href={`/events/${volunteerEvent.id}/`}>{volunteerEvent.title}</a>
    </h3>

    <dl class="meta">
      <div>
        <dt>Date and time</dt>
        <dd>
          <time datetime={`${volunteerEvent.formattedDate} ${volunteerEvent.time}`}>
            {volunteerEvent.formattedDate} · {volunteerEvent.time}
          </time>
        </dd>
      </div>
      <div>
        <dt>Meeting location</dt>
        <dd>
          <a href={volunteerEvent.directionsLink}>{volunteerEvent.meetingLocation}</a>
        </dd>
      </div>
    </dl>

    {
      volunteerEvent.meetingNotes && (
        <div class="notes">
          <p class="notes-label">Meeting details</p>
          <p class="notes-copy">{volunteerEvent.meetingNotes}</p>
        </div>
      )
    }
  </div>

  <div class="actions">
    {
      volunteerEvent.registrationLink && (
        <a href={volunteerEvent.registrationLink} class="button button--brand register">
          Register
        </a>
      )
    }
    <a
      href="https://coloradosprings.gov/sites/default/files/inline-images/informed_consent_and_release_form-fillable.pdf"
      class="button button--quiet release"
    >
      Consent and release form
    </a>
  </div>
</article>

<style>
  .volunteer-item {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.75rem;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }

  .volunteer-item .details {
    display: grid;
    flex: 1;
    gap: 1rem;
  }

  .volunteer-item .heading {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .volunteer-item .heading a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .volunteer-item .heading a:hover {
    color: var(--color-brand-strong);
  }

  .volunteer-item .meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 2rem;
    margin: 0;
  }

  .volunteer-item .meta div {
    display: grid;
    gap: 0.25rem;
  }

  .volunteer-item .meta dt {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 500;
  }

  .volunteer-item .meta dd {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .volunteer-item .meta a {
    color: var(--color-brand-strong);
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22rem;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .volunteer-item .meta a:hover {
    color: var(--color-brand);
  }

  .volunteer-item .notes {
    display: grid;
    gap: 0.25rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-page);
    padding: 0.875rem 1.125rem;
  }

  .volunteer-item .notes-label {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 700;
  }

  .volunteer-item .notes-copy {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 400;
    line-height: 1.55;
  }

  .volunteer-item .actions {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.875rem;
  }

  .volunteer-item .register,
  .volunteer-item .release {
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  @media (min-width: 40rem) {
    .volunteer-item .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .volunteer-item .actions {
      flex-direction: row;
      width: auto;
    }

    .volunteer-item .register,
    .volunteer-item .release {
      width: auto;
    }
  }

  @media (min-width: 64rem) {
    .volunteer-item {
      flex-direction: row;
      align-items: center;
    }

    .volunteer-item .actions {
      flex-direction: column;
      align-items: stretch;
      min-width: 15rem;
    }
  }
</style>
